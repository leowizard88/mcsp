<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ site.subtitle }}">
  <link rel="icon" href="/favicon.svg?v=20260706-3" type="image/svg+xml">
  <link rel="shortcut icon" href="/favicon.svg?v=20260706-3" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/favicon.svg?v=20260706-3">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="stylesheet" href="/assets/css/profile-photo-clean.css?v=20260706-1">
  <link rel="stylesheet" href="/assets/css/editor-light.css?v=20260706-1">
  <link rel="stylesheet" href="/assets/css/star-offset.css?v=20260706-4">
  <link rel="stylesheet" href="/assets/css/text-flow-fixes.css?v=20260706-13">
  <link rel="stylesheet" href="/assets/css/archive-and-ornament-final.css?v=20260706-4">
  <link rel="stylesheet" href="/assets/css/article-rail.css?v=20260707-rail-js-2">
  <link rel="stylesheet" href="/assets/css/footnotes.css?v=20260706-1">
  <link rel="stylesheet" href="/assets/css/profile-quote-koko.css?v=20260707-page-1">
  <style>
    html,
    body,
    .site-main {
      background: #050000 !important;
    }

    html,
    body {
      max-width: 100%;
      overflow-x: hidden !important;
    }

    body:has(.single-page),
    body:has(.archive-page),
    .site-main:has(.single-page),
    .site-main:has(.archive-page) {
      background: #fbfaf5 !important;
    }

    body:has(.archive-system-page),
    .site-main:has(.archive-system-page) {
      background: #8b0000 !important;
    }

    body:has(.ultimi-page),
    .site-main:has(.ultimi-page) {
      background: #050000 !important;
    }

    .chat-reply-toggle {
      display: none !important;
      visibility: hidden !important;
    }

    .chat-reply {
      display: grid !important;
      grid-template-columns: minmax(80px, 120px) minmax(130px, 240px) max-content !important;
      gap: 4px !important;
      align-items: center !important;
      margin-top: 5px !important;
      max-width: min(400px, 100%) !important;
    }

    .chat-reply input,
    .chat-reply textarea {
      width: 100% !important;
      min-height: 22px !important;
      height: 22px !important;
      box-sizing: border-box !important;
      border: 1px solid rgba(31,28,24,.30) !important;
      border-radius: 0 !important;
      background: rgba(234,215,179,.14) !important;
      color: #120d08 !important;
      box-shadow: none !important;
      outline: none !important;
      font: 300 10px/1 var(--font-sans, system-ui, sans-serif) !important;
      letter-spacing: .02em !important;
      padding: 3px 5px !important;
      appearance: none !important;
    }

    .chat-reply textarea {
      resize: vertical !important;
    }

    .chat-reply input:focus,
    .chat-reply textarea:focus {
      border-color: rgba(31,28,24,.62) !important;
      background: rgba(234,215,179,.24) !important;
    }

    .chat-reply button[type="submit"] {
      width: auto !important;
      min-width: 42px !important;
      min-height: 22px !important;
      height: 22px !important;
      border: 1px solid rgba(31,28,24,.44) !important;
      border-radius: 0 !important;
      background: rgba(31,28,24,.88) !important;
      color: #ead7b3 !important;
      box-shadow: none !important;
      font: 300 7px/1 var(--font-sans, system-ui, sans-serif) !important;
      letter-spacing: .08em !important;
      text-transform: uppercase !important;
      padding: 0 5px !important;
      cursor: pointer !important;
      appearance: none !important;
    }

    .chat-reply button[type="submit"]:hover,
    .chat-reply button[type="submit"]:focus {
      background: rgba(18,13,8,.96) !important;
      transform: none !important;
    }

    .side-index {
      background: rgba(0,0,0,.96) !important;
      border-right: 1px solid rgba(255,255,255,.22) !important;
      color: #fff !important;
    }

    .spine-logo svg {
      stroke: #fff !important;
    }

    .vertical-nav {
      flex-direction: row-reverse !important;
    }

    .vertical-nav a {
      color: #fff !important;
      opacity: .84 !important;
      text-align: center !important;
    }

    .vertical-nav a:hover,
    .vertical-nav a.is-active {
      opacity: 1 !important;
    }

    @media(max-width:760px) {
      .side-index {
        display: flex !important;
        width: var(--side) !important;
      }

      .site-main {
        width: calc(100vw - var(--side)) !important;
        max-width: calc(100vw - var(--side)) !important;
        margin-left: var(--side) !important;
        overflow-x: hidden !important;
      }

      #chat.chat-panel {
        display: grid !important;
        visibility: visible !important;
        min-height: 100vh !important;
        height: auto !important;
        overflow: visible !important;
      }

      #chat .chat-board {
        display: block !important;
        visibility: visible !important;
        width: calc(100vw - var(--side) - 28px) !important;
        max-width: calc(100vw - var(--side) - 28px) !important;
        margin: 0 auto !important;
      }

      #chat .chat-messages {
        display: grid !important;
        visibility: visible !important;
        max-height: none !important;
        overflow: visible !important;
      }

      .chat-reply {
        grid-template-columns: minmax(0, 1fr) max-content !important;
        max-width: 100% !important;
      }

      .chat-reply input {
        grid-column: 1 / -1 !important;
      }
    }
  </style>
</head>
<body>
  <aside class="side-index" aria-label="Indice principale">
    <a class="spine-logo" href="/" aria-label="MANCUSPIE home">
      <svg viewBox="0 0 24 120" role="img" aria-hidden="true">
        <path d="M12 4 C10 18 15 27 12 40 C9 53 15 63 12 76 C9 88 14 99 12 116" />
        <ellipse cx="12" cy="13" rx="6" ry="3" />
        <ellipse cx="12" cy="27" rx="7" ry="3.2" />
        <ellipse cx="12" cy="42" rx="6.4" ry="3" />
        <ellipse cx="12" cy="57" rx="7" ry="3.3" />
        <ellipse cx="12" cy="72" rx="6.2" ry="3" />
        <ellipse cx="12" cy="87" rx="7" ry="3.2" />
        <ellipse cx="12" cy="103" rx="5.8" ry="2.8" />
      </svg>
    </a>

    <nav class="vertical-nav">
      {% for item in nav %}
      <a href="{{ item.url }}">{{ item.label | safe }}</a>
      {% endfor %}
    </nav>
  </aside>

  <main class="site-main">
    {{ content | safe }}
  </main>

  <script src="/assets/js/articoli-data.js?v=20260706-1"></script>
  <script src="/assets/js/account-ui.js?v=20260706-2"></script>
  <script src="/assets/js/chat-board-restore.js?v=20260707-home-only-1"></script>
  <script src="/assets/js/script.js?v=20260707-board-prompt-2"></script>
  <script src="/assets/js/bacheca-failsafe.js?v=20260707-bacheca-safe-1"></script>
  <script src="/assets/js/bacheca-ui-fix.js?v=20260707-bacheca-ui-fix-1"></script>
  <script src="/assets/js/profile-links.js?v=20260706-1"></script>
  <script src="/assets/js/role-badges.js?v=20260706-1"></script>
  <script src="/assets/js/chat-pager.js?v=20260706-2"></script>
  <script src="/assets/js/article-owner-tools.js?v=20260706-3"></script>
  <script src="/assets/js/article-edit-link.js?v=20260706-1"></script>
  <script src="/assets/js/editor-type-idee.js?v=20260706-1"></script>
  <script src="/assets/js/editor-align-tools.js?v=20260706-1"></script>
  <script src="/assets/js/editor-footnotes.js?v=20260706-1"></script>
  <script src="/assets/js/article-comments.js?v=20260707-comments-2"></script>
  <script src="/assets/js/article-ornament-column.js?v=20260707-scroll-2"></script>
  <script src="/assets/js/koko-profile-quote.js?v=20260707-koko-page-3"></script>
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</body>
</html>