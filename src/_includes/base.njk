<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ site.subtitle }}">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/style.css">
  <style>
    html,
    body,
    .site-main {
      background: #050000 !important;
    }

    html,
    body {
      max-width: 100%;
      overflow-x: hidden !important;
    }

    body:has(.single-page),
    body:has(.archive-page),
    .site-main:has(.single-page),
    .site-main:has(.archive-page) {
      background: #fbfaf5 !important;
    }

    body:has(.archive-system-page),
    .site-main:has(.archive-system-page) {
      background: #8b0000 !important;
    }

    body:has(.ultimi-page),
    .site-main:has(.ultimi-page) {
      background: #050000 !important;
    }

    .side-index {
      background: rgba(0,0,0,.96) !important;
      border-right: 1px solid rgba(255,255,255,.22) !important;
      color: #fff !important;
    }

    .spine-logo svg {
      stroke: #fff !important;
    }

    .vertical-nav {
      flex-direction: row-reverse !important;
    }

    .vertical-nav a {
      color: #fff !important;
      opacity: .84 !important;
      text-align: center !important;
    }

    .vertical-nav a:hover,
    .vertical-nav a.is-active {
      opacity: 1 !important;
    }

    @media(max-width:760px) {
      .side-index {
        display: flex !important;
        width: var(--side) !important;
      }

      .site-main {
        width: calc(100vw - var(--side)) !important;
        max-width: calc(100vw - var(--side)) !important;
        margin-left: var(--side) !important;
        overflow-x: hidden !important;
      }
    }
  </style>
  <script>
    if (location.pathname.indexOf('/zingaristan/tesseramento') === 0) {
      const nativeToDataURL = HTMLCanvasElement.prototype.toDataURL;
      HTMLCanvasElement.prototype.toDataURL = function(type, quality) {
        if (type === 'image/png' && this.width > 900) {
          const small = document.createElement('canvas');
          small.width = 900;
          small.height = Math.round(this.height * (900 / this.width));
          const ctx = small.getContext('2d');
          ctx.drawImage(this, 0, 0, small.width, small.height);
          return nativeToDataURL.call(small, 'image/png', quality);
        }
        return nativeToDataURL.call(this, type, quality);
      };
    }
  </script>
</head>
<body>
  <aside class="side-index" aria-label="Indice principale">
    <a class="spine-logo" href="/" aria-label="MANCUSPIE home">
      <svg viewBox="0 0 24 120" role="img" aria-hidden="true">
        <path d="M12 4 C10 18 15 27 12 40 C9 53 15 63 12 76 C9 88 14 99 12 116" />
        <ellipse cx="12" cy="13" rx="6" ry="3" />
        <ellipse cx="12" cy="27" rx="7" ry="3.2" />
        <ellipse cx="12" cy="42" rx="6.4" ry="3" />
        <ellipse cx="12" cy="57" rx="7" ry="3.3" />
        <ellipse cx="12" cy="72" rx="6.2" ry="3" />
        <ellipse cx="12" cy="87" rx="7" ry="3.2" />
        <ellipse cx="12" cy="103" rx="5.8" ry="2.8" />
      </svg>
    </a>

    <nav class="vertical-nav">
      {% for item in nav %}
      <a href="{{ item.url }}">{{ item.label | safe }}</a>
      {% endfor %}
    </nav>
  </aside>

  <main class="site-main">
    {{ content | safe }}
  </main>

  <script src="/assets/js/script.js?v=20260706-2"></script>
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", function(user) {
        if (!user && window.location.hash.indexOf("invite_token") !== -1) {
          window.netlifyIdentity.open("signup");
        }

        if (!user && window.location.hash.indexOf("recovery_token") !== -1) {
          window.location.href = "/admin/";
        }
      });

      window.netlifyIdentity.on("login", function() {
        window.location.href = "/admin/";
      });
    }
  </script>
</body>
</html>
