---
layout: base.njk
---
<article class="single-page panel article-page-format">
<div class="single-inner article-format-inner">
<header class="article-format-head" data-article-head data-article-author="{{ author }}" data-article-path="{{ page.inputPath }}" data-article-title="{{ title }}">
<p class="article-format-author">{% if author %}<a href="/profilo/?u={{ author | urlencode }}">{{ author }}</a>{% endif %}</p>
<h1>{{ title }}</h1>
{% if subtitle %}<p class="article-subtitle">{{ subtitle }}</p>{% endif %}
</header>
<div class="single-body article-format-body">{{ content | safe }}</div>
<a class="text-link" href="/archivio/">← Torna all’archivio</a>
</div>
</article>
<style>
.article-page-format{background:#fbfaf5!important}.article-format-inner{max-width:880px;margin-left:clamp(22px,5vw,72px);margin-right:auto;padding-top:clamp(22px,4vw,54px)}.article-format-body{max-width:760px;color:#050505;font-family:var(--font-serif,Georgia,'Times New Roman',serif);font-size:clamp(20px,2.05vw,27px);font-weight:300;line-height:1.48}.article-format-head h1{display:inline-block;margin:0;padding:0 10px 8px 0;border-bottom:2px solid #050505;color:#050505;font-family:var(--font-serif,Georgia,'Times New Roman',serif);font-size:clamp(54px,8vw,98px);font-weight:300;line-height:.88;letter-spacing:-.045em;text-transform:none}.article-subtitle{max-width:720px;margin:16px 0 0;color:#050505;font-family:var(--font-serif,Georgia,'Times New Roman',serif);font-size:clamp(22px,2.8vw,36px);font-weight:300;line-height:1.1}.article-ornament-column,.article-ornament-track,.article-ornament-block,[data-article-ornament-column]{display:none!important;visibility:hidden!important}body::after{content:""!important;position:fixed!important;top:-120vh!important;right:0!important;width:var(--article-ornament-width,150px)!important;height:240vh!important;z-index:999!important;pointer-events:none!important;background-image:url('/assets/img/m2.png?v=20260707-inline-rail')!important;background-repeat:repeat-y!important;background-size:100% auto!important;background-position:0 0!important;animation:mInlineRail 4.8s linear infinite!important;will-change:transform!important;transform:translate3d(0,-55vh,0)!important}@keyframes mInlineRail{from{transform:translate3d(0,-55vh,0)}to{transform:translate3d(0,0,0)}}@media(max-width:760px){.article-format-inner{margin-left:18px;margin-right:10px;padding-top:16px}.article-format-head h1{font-size:clamp(50px,16vw,76px)}.article-format-body{font-size:clamp(19px,5.8vw,24px);line-height:1.52}body::after{width:var(--article-ornament-width,52px)!important;animation-duration:4.4s!important}}
</style>
