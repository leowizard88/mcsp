---
layout: base.njk
title: Aggiungi materiali | MANCUSPIE
permalink: /aggiungi-materiali/
---
<section class="add-material-page panel">
  <div class="add-material-root" data-add-material-root><p class="add-material-status">Verifica permessi...</p></div>
</section>
<style>
  body:has(.add-material-page),body:has(.add-material-page) .site-main{background:#17362f!important}.add-material-page{min-height:100vh;box-sizing:border-box;padding:clamp(28px,5.8vw,78px);color:#f5f0dd;background:linear-gradient(136deg,#245f50,#17362f 55%,#0b1714)!important}.add-material-root{width:min(940px,100%);margin:0 auto}.add-material-kicker{margin:0 0 10px;color:rgba(245,240,221,.7);font:400 11px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.2em;text-transform:uppercase}.add-material-root h1{margin:0 0 38px;font:300 clamp(64px,12vw,148px)/.76 var(--font-serif,Georgia,serif);letter-spacing:-.055em;text-transform:uppercase}.add-material-card{max-width:760px;padding:clamp(20px,3vw,34px);background:rgba(0,0,0,.22)}.add-material-field{display:grid;gap:7px;margin-bottom:15px;font:400 11px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.14em;text-transform:uppercase}.add-material-field input,.add-material-field textarea,.add-material-field select{box-sizing:border-box;width:100%;border:0;background:rgba(0,0,0,.34);color:#f5f0dd;padding:13px;font:16px/1.35 var(--font-sans,system-ui,sans-serif)}.add-material-field textarea{min-height:150px;resize:vertical}.add-material-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.add-material-actions button,.add-material-actions a{border:0;background:#f5f0dd;color:#17362f;padding:12px 14px;font:700 10px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.14em;text-transform:uppercase;text-decoration:none;cursor:pointer}.add-material-status{min-height:19px;margin:14px 0 0;font:15px/1.35 var(--font-sans,system-ui,sans-serif)}.is-hidden{display:none!important}
</style>
<script>
(() => {
  const root=document.querySelector('[data-add-material-root]');const token=localStorage.getItem('mancuspieAuthToken')||'';const headers=()=>token?{authorization:'Bearer '+token}:{};const esc=v=>String(v||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fail=m=>root.innerHTML='<p class="add-material-kicker">Redazione</p><h1>Aggiungi materiali</h1><p class="add-material-status">'+esc(m)+'</p><div class="add-material-actions"><a href="/profilo/">Profilo</a></div>';
  const encode=file=>new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(String(reader.result).split(',')[1]||'');reader.onerror=reject;reader.readAsDataURL(file)});
  const build=user=>{root.innerHTML='<p class="add-material-kicker">Redazione / '+esc(user.username)+'</p><h1>Aggiungi materiali</h1><form class="add-material-card" data-form><label class="add-material-field">Titolo <input data-title maxlength="160" required></label><label class="add-material-field">File o link <select data-kind><option value="file">Carica un file</option><option value="link">Inserisci un link</option></select></label><label class="add-material-field" data-file-field>File <input data-file type="file" required></label><label class="add-material-field is-hidden" data-link-field>URL del link <input data-url type="url" placeholder="https://"></label><label class="add-material-field">Nome del file o link <input data-name maxlength="120" placeholder="opzionale"></label><label class="add-material-field">Descrizione <textarea data-description maxlength="1200" placeholder="opzionale"></textarea></label><p class="add-material-status" data-status></p><div class="add-material-actions"><button type="submit">Invia</button><a href="/profilo/">Profilo</a></div></form>';const form=root.querySelector('[data-form]'),kind=root.querySelector('[data-kind]'),file=root.querySelector('[data-file]'),url=root.querySelector('[data-url]'),fileField=root.querySelector('[data-file-field]'),linkField=root.querySelector('[data-link-field]'),status=root.querySelector('[data-status']);const switchKind=()=>{const isFile=kind.value==='file';fileField.classList.toggle('is-hidden',!isFile);linkField.classList.toggle('is-hidden',isFile);file.required=isFile;url.required=!isFile};kind.addEventListener('change',switchKind);form.addEventListener('submit',async e=>{e.preventDefault();status.textContent='Invio materiale...';try{const payload={title:root.querySelector('[data-title]').value,kind:kind.value,name:root.querySelector('[data-name]').value,description:root.querySelector('[data-description]').value,url:url.value};if(kind.value==='file'){const chosen=file.files&&file.files[0];if(!chosen)throw new Error('Scegli un file');payload.filename=chosen.name;payload.mime=chosen.type;payload.content=await encode(chosen)}const response=await fetch('/api/materials',{method:'POST',headers:{'content-type':'application/json',...headers()},body:JSON.stringify(payload)});const result=await response.json().catch(()=>({}));if(!response.ok)throw new Error(result.error||'Invio fallito');status.textContent='Materiale aggiunto. Il sito si aggiornerà tra poco.';setTimeout(()=>location.href='/materiali/',1300)}catch(error){status.textContent=error.message}})};
  const load=async()=>{if(!token){fail('Login richiesto.');return}const response=await fetch('/api/auth',{headers:headers(),cache:'no-store'});const data=await response.json().catch(()=>({}));if(!response.ok||!data.user||!data.user.isRedattore){fail('Permesso redattore richiesto.');return}build(data.user)};load().catch(e=>fail(e.message||'Errore permessi.'));
})();
</script>
