---
layout: base.njk
title: Archivio | MANCUSPIE
permalink: /archivio/
---
<style>
  .archive-system-page {
    min-height: 100vh;
    background:
      repeating-linear-gradient(90deg, transparent 0 31px, rgba(79, 0, 112, .16) 31px 32px, transparent 32px 83px),
      repeating-linear-gradient(90deg, transparent 0 67px, rgba(119, 35, 154, .11) 67px 68px, transparent 68px 151px),
      repeating-linear-gradient(90deg, transparent 0 109px, rgba(37, 0, 78, .20) 109px 110px, transparent 110px 229px),
      #8b0000;
    padding: clamp(42px, 6vw, 90px);
    color: #090000;
    overflow: hidden;
  }

  .archive-system-page::before,
  .archive-system-page::after { display: none !important; }

  .archive-bg-img {
    position: fixed;
    z-index: 1;
    right: clamp(-160px, -9vw, -52px);
    bottom: clamp(-120px, -7vw, -34px);
    width: clamp(620px, 66vw, 1120px);
    max-width: none;
    height: auto;
    pointer-events: none;
    opacity: 1;
  }

  .archive-system-inner {
    position: relative;
    z-index: 4;
    max-width: 1060px;
    margin: 0 auto;
  }

  .archive-system-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: clamp(24px, 5vw, 90px);
    border-bottom: 1px solid rgba(9,0,0,.34);
    padding-bottom: clamp(22px, 3.5vw, 44px);
    margin-bottom: clamp(28px, 5vw, 58px);
  }

  .archive-system-head h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(70px, 12vw, 174px);
    line-height: .78;
    font-weight: 300;
    letter-spacing: .045em;
    text-transform: uppercase;
    color: #090000;
  }

  .archive-back {
    font: 300 11px/1 var(--font-sans);
    letter-spacing: .16em;
    text-transform: uppercase;
    color: #090000;
    border-bottom: 1px solid rgba(9,0,0,.55);
    padding-bottom: 8px;
    white-space: nowrap;
  }

  .archive-controls {
    display: grid;
    gap: 16px;
    margin: 0 0 clamp(30px, 5vw, 62px);
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(9,0,0,.28);
  }

  .archive-modes,
  .archive-values {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .archive-filter {
    border: 1px solid rgba(9,0,0,.46);
    background: rgba(139,0,0,.08);
    color: #090000;
    padding: 11px 13px;
    font: 300 11px/1 var(--font-sans);
    letter-spacing: .13em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .archive-filter.is-active {
    background: #090000;
    color: #8b0000;
  }

  .archive-filter:disabled {
    opacity: .42;
    cursor: default;
  }

  .archive-status {
    margin: 0;
    font: 300 12px/1.35 var(--font-sans);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: rgba(9,0,0,.68);
  }

  .archive-chronology { display: grid; gap: 0; }

  .archive-row {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 150px;
    gap: 28px;
    align-items: start;
    min-width: 0;
    width: 100%;
    padding: 20px 0 22px;
    border-bottom: 1px solid rgba(9,0,0,.28);
    color: #090000;
    overflow: hidden;
  }

  .archive-row > div {
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
  }

  .archive-row time,
  .archive-row em,
  .archive-row small {
    font: 300 11px/1.35 var(--font-sans);
    letter-spacing: .15em;
    text-transform: uppercase;
    color: rgba(9,0,0,.64);
    font-style: normal;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .archive-row em { max-width: 150px; }

  .archive-row strong {
    font-family: var(--font-serif);
    font-size: clamp(24px, 2.7vw, 42px);
    line-height: 1.12;
    font-weight: 300;
    letter-spacing: 0;
    text-transform: none;
    color: #090000;
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: normal;
    hyphens: none;
  }

  .archive-row span {
    display: block;
    margin-top: 8px;
    max-width: 100%;
    font: 300 clamp(14px, 1.15vw, 18px)/1.25 var(--font-serif);
    color: rgba(9,0,0,.72);
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .archive-row:hover { background: rgba(68,0,100,.10); }
  .archive-row:hover strong { transform: none; }
  .archive-empty { font: 300 24px/1.1 var(--font-serif); }

  @media(max-width:760px){
    .archive-system-page{padding:34px 22px}
    .archive-bg-img{width:560px;right:-190px;bottom:-86px;opacity:1}
    .archive-system-head{display:block}
    .archive-system-head h1{font-size:clamp(50px,16vw,82px)}
    .archive-back{display:inline-block;margin-top:22px}
    .archive-row{grid-template-columns:1fr;gap:8px}
    .archive-row strong{font-size:clamp(34px,10vw,54px)}
  }
</style>

<section class="archive-system-page panel">
  <img class="archive-bg-img" src="/assets/img/b7db19117443e1ac718e6e183b5f7299-removebg-preview.png" alt="" aria-hidden="true">
  <div class="archive-system-inner">
    <header class="archive-system-head">
      <h1>Archivio</h1>
      <a class="archive-back" href="/ultimi-movimenti/">ultimi movimenti</a>
    </header>

    <div class="archive-controls" data-archive-controls>
      <div class="archive-modes" aria-label="Ordini di ricerca archivio">
        <button class="archive-filter is-active" type="button" data-mode="cronologico">Cronologico</button>
        <button class="archive-filter" type="button" data-mode="autore">Autore</button>
        <button class="archive-filter" type="button" data-mode="tipo">Tipologico</button>
        <button class="archive-filter" type="button" data-mode="rubrica">Rubricologico</button>
      </div>
      <div class="archive-values" data-archive-values></div>
      <p class="archive-status" data-archive-status></p>
    </div>

    <div class="archive-chronology" data-archive-list aria-label="Archivio cronologico degli articoli"></div>
  </div>
</section>

<script>
(() => {
  const posts = [
    {% for post in collections.testi | reverse %}
    {
      title: {{ post.data.title | json | safe }},
      subtitle: {{ post.data.subtitle | json | safe }},
      author: {{ post.data.author | json | safe }},
      tipo: {{ post.data.tipo | json | safe }},
      rubrica: {{ post.data.rubrica | json | safe }},
      date: {{ (post.data.date | dateISO) | json | safe }},
      url: {{ post.url | json | safe }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ];

  const list = document.querySelector('[data-archive-list]');
  const values = document.querySelector('[data-archive-values]');
  const status = document.querySelector('[data-archive-status]');
  const modeButtons = [...document.querySelectorAll('[data-mode]')];
  let mode = 'cronologico';
  let selected = '';

  const esc = value => String(value || '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
  const label = value => value || 'senza voce';
  const chronological = items => [...items].sort((a, b) => String(b.date).localeCompare(String(a.date)));
  const unique = field => [...new Set(posts.map(post => post[field]).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'it'));

  const renderList = items => {
    if (!items.length) {
      list.innerHTML = '<p class="archive-empty">Nessun articolo in archivio.</p>';
      return;
    }
    list.innerHTML = chronological(items).map(post => `
      <a class="archive-row" href="${esc(post.url)}">
        <time datetime="${esc(post.date)}">${esc(post.date)}</time>
        <div><strong>${esc(post.title)}</strong>${post.subtitle ? `<span>${esc(post.subtitle)}</span>` : ''}</div>
        <em>${esc(post.author)}${post.tipo ? `<br><small>${esc(post.tipo)}</small>` : ''}${post.rubrica ? `<br><small>${esc(post.rubrica)}</small>` : ''}</em>
      </a>
    `).join('');
  };

  const renderValues = () => {
    values.innerHTML = '';
    selected = '';
    if (mode === 'cronologico') return;

    const field = mode === 'autore' ? 'author' : mode;
    const items = unique(field);
    values.innerHTML = items.map(item => `<button class="archive-filter" type="button" data-value="${esc(item)}">${esc(item)}</button>`).join('');
    if (!items.length) values.innerHTML = '<button class="archive-filter" type="button" disabled>Nessuna voce</button>';
  };

  const render = () => {
    modeButtons.forEach(button => button.classList.toggle('is-active', button.dataset.mode === mode));
    document.querySelectorAll('[data-value]').forEach(button => button.classList.toggle('is-active', button.dataset.value === selected));

    let items = posts;
    let labelText = 'Cronologico, più nuovo in alto';
    if (mode !== 'cronologico') {
      const field = mode === 'autore' ? 'author' : mode;
      items = selected ? posts.filter(post => post[field] === selected) : [];
      labelText = selected ? `${mode}: ${selected}` : `Seleziona ${mode === 'autore' ? 'un autore' : mode === 'tipo' ? 'un tipo' : 'una rubrica'}`;
    }

    status.textContent = `${labelText} · ${items.length} articol${items.length === 1 ? 'o' : 'i'}`;
    renderList(items);
  };

  modeButtons.forEach(button => button.addEventListener('click', () => {
    mode = button.dataset.mode;
    renderValues();
    render();
  }));

  values.addEventListener('click', event => {
    const button = event.target.closest('[data-value]');
    if (!button) return;
    selected = button.dataset.value;
    render();
  });

  renderValues();
  render();
})();
</script>
