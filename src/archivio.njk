---
layout: base.njk
title: Archivio | MANCUSPIE
permalink: /archivio/
---
<style>
  @import url('https://fonts.googleapis.com/css2?family=Metal+Mania&display=swap');

  .archive-system-page {
    min-height: 100vh;
    background: #8b0000;
    padding: clamp(42px, 6vw, 88px);
    color: #050000;
    overflow: hidden;
  }

  .archive-system-page::before,
  .archive-system-page::after {
    display: none !important;
  }

  .archive-system-inner {
    position: relative;
    z-index: 4;
    max-width: 1120px;
    margin: 0 auto;
  }

  .archive-system-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid rgba(5,0,0,.42);
    padding-bottom: 22px;
    margin-bottom: clamp(28px, 4vw, 58px);
  }

  .archive-system-head h1 {
    margin: 0;
    font-family: 'Metal Mania', fantasy;
    font-size: clamp(76px, 13vw, 190px);
    line-height: .70;
    font-weight: 400;
    letter-spacing: .035em;
    text-transform: uppercase;
    color: #050000;
    -webkit-text-stroke: .28px #050000;
    transform: scaleX(.50) skewX(-10deg);
    transform-origin: left bottom;
    filter: contrast(1.55);
    clip-path: polygon(0 0,100% 0,100% 9%,88% 9%,88% 14%,100% 14%,100% 26%,74% 26%,74% 30%,100% 30%,100% 44%,91% 44%,91% 49%,100% 49%,100% 63%,80% 63%,80% 68%,100% 68%,100% 100%,0 100%,0 82%,16% 82%,16% 78%,0 78%,0 55%,9% 55%,9% 51%,0 51%,0 34%,20% 34%,20% 30%,0 30%);
  }

  .archive-back {
    font: 300 11px/1 var(--font-sans);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #050000;
    border-bottom: 1px solid currentColor;
    padding-bottom: 7px;
    white-space: nowrap;
  }

  .archive-chronology {
    display: grid;
    gap: 0;
  }

  .archive-row {
    display: grid;
    grid-template-columns: minmax(110px, 160px) 1fr minmax(110px, 180px);
    gap: clamp(18px, 3vw, 50px);
    align-items: baseline;
    padding: clamp(18px, 2.5vw, 32px) 0;
    border-bottom: 1px solid rgba(5,0,0,.34);
    color: #050000;
  }

  .archive-row time,
  .archive-row em {
    font: 300 12px/1.2 var(--font-sans);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(5,0,0,.72);
    font-style: normal;
  }

  .archive-row strong {
    font-family: 'Metal Mania', fantasy;
    font-size: clamp(38px, 5.8vw, 86px);
    line-height: .76;
    font-weight: 400;
    letter-spacing: .035em;
    text-transform: uppercase;
    color: #050000;
    display: inline-block;
    -webkit-text-stroke: .22px #050000;
    transform: scaleX(.48) skewX(-8deg);
    transform-origin: left center;
    filter: contrast(1.55);
    clip-path: polygon(0 0,100% 0,100% 8%,86% 8%,86% 13%,100% 13%,100% 23%,70% 23%,70% 28%,100% 28%,100% 39%,90% 39%,90% 45%,100% 45%,100% 61%,78% 61%,78% 66%,100% 66%,100% 100%,0 100%,0 86%,12% 86%,12% 80%,0 80%,0 57%,18% 57%,18% 52%,0 52%,0 31%,10% 31%,10% 26%,0 26%);
  }

  .archive-row:hover {
    background: rgba(5,0,0,.10);
  }

  .archive-row:hover strong {
    transform: scaleX(.48) skewX(-8deg) translateX(8px);
    clip-path: polygon(0 0,100% 0,100% 12%,75% 12%,75% 17%,100% 17%,100% 32%,88% 32%,88% 38%,100% 38%,100% 52%,64% 52%,64% 58%,100% 58%,100% 100%,0 100%,0 75%,19% 75%,19% 69%,0 69%,0 46%,11% 46%,11% 40%,0 40%);
  }

  @media(max-width:760px){
    .archive-system-page{padding:34px 22px}
    .archive-system-head{display:block}
    .archive-back{display:inline-block;margin-top:20px}
    .archive-row{grid-template-columns:1fr;gap:8px}
  }
</style>

<section class="archive-system-page panel">
  <div class="archive-system-inner">
    <header class="archive-system-head">
      <h1>Archivio</h1>
      <a class="archive-back" href="/ultimi-movimenti/">ultimi movimenti</a>
    </header>

    <div class="archive-chronology" aria-label="Archivio cronologico degli articoli">
      {% for post in collections.testi | reverse %}
      <a class="archive-row" href="{{ post.url }}">
        <time datetime="{{ post.data.date | dateISO }}">{{ post.data.date | dateISO }}</time>
        <strong>{{ post.data.title }}</strong>
        <em>{{ post.data.author }}</em>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
