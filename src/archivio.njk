---
layout: base.njk
title: Archivio | MANCUSPIE
permalink: /archivio/
---
<style>
  @import url('https://fonts.googleapis.com/css2?family=Metal+Mania&display=swap');

  .archive-system-page {
    min-height: 100vh;
    background:
      linear-gradient(90deg, transparent 0 8px, rgba(92,0,130,.18) 8px 9px, transparent 9px 37px),
      linear-gradient(90deg, transparent 0 21px, rgba(126,30,180,.13) 21px 22px, transparent 22px 64px),
      linear-gradient(90deg, transparent 0 43px, rgba(44,0,92,.20) 43px 44px, transparent 44px 91px),
      #8b0000;
    background-size: 113px 100%, 173px 100%, 251px 100%, auto;
    padding: clamp(42px, 6vw, 88px);
    color: #050000;
    overflow: hidden;
  }

  .archive-system-page::before,
  .archive-system-page::after {
    display: none !important;
  }

  .archive-system-inner {
    position: relative;
    z-index: 4;
    max-width: 1120px;
    margin: 0 auto;
  }

  .archive-system-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid rgba(5,0,0,.42);
    padding-bottom: 22px;
    margin-bottom: clamp(28px, 4vw, 58px);
  }

  .archive-system-head h1 {
    margin: 0;
    font-family: 'Metal Mania', fantasy;
    font-size: clamp(78px, 13vw, 194px);
    line-height: .70;
    font-weight: 400;
    letter-spacing: .050em;
    text-transform: uppercase;
    color: #050000;
    -webkit-text-fill-color: #050000;
    -webkit-text-stroke: 0;
    text-shadow: none;
    transform: scaleX(.36) skewX(-9deg) rotate(-1deg);
    transform-origin: left bottom;
    clip-path: polygon(0 0,100% 0,100% 10%,86% 10%,86% 15%,100% 15%,100% 30%,72% 30%,72% 34%,100% 34%,100% 50%,91% 50%,91% 55%,100% 55%,100% 72%,78% 72%,78% 77%,100% 77%,100% 100%,0 100%,0 84%,12% 84%,12% 78%,0 78%,0 57%,8% 57%,8% 52%,0 52%,0 35%,18% 35%,18% 30%,0 30%);
  }

  .archive-back {
    font: 300 11px/1 var(--font-sans);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #050000;
    border-bottom: 1px solid currentColor;
    padding-bottom: 7px;
    white-space: nowrap;
  }

  .archive-chronology {
    display: grid;
    gap: 0;
  }

  .archive-row {
    display: grid;
    grid-template-columns: minmax(110px, 160px) 1fr minmax(110px, 180px);
    gap: clamp(18px, 3vw, 50px);
    align-items: baseline;
    padding: clamp(18px, 2.5vw, 32px) 0;
    border-bottom: 1px solid rgba(5,0,0,.34);
    color: #050000;
  }

  .archive-row time,
  .archive-row em {
    font: 300 12px/1.2 var(--font-sans);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(5,0,0,.72);
    font-style: normal;
  }

  .archive-row strong {
    font-family: 'Metal Mania', fantasy;
    font-size: clamp(40px, 5.9vw, 88px);
    line-height: .76;
    font-weight: 400;
    letter-spacing: .052em;
    text-transform: uppercase;
    color: #050000;
    -webkit-text-fill-color: #050000;
    display: inline-block;
    -webkit-text-stroke: 0;
    text-shadow: none;
    transform: scaleX(.34) skewX(-8deg) rotate(.35deg);
    transform-origin: left center;
    clip-path: polygon(0 0,100% 0,100% 9%,84% 9%,84% 14%,100% 14%,100% 25%,68% 25%,68% 30%,100% 30%,100% 42%,89% 42%,89% 47%,100% 47%,100% 62%,76% 62%,76% 68%,100% 68%,100% 100%,0 100%,0 86%,11% 86%,11% 80%,0 80%,0 58%,16% 58%,16% 52%,0 52%,0 32%,9% 32%,9% 26%,0 26%);
  }

  .archive-row:hover {
    background: rgba(76,0,120,.10);
  }

  .archive-row:hover strong {
    transform: scaleX(.34) skewX(-8deg) translateX(8px) rotate(-.35deg);
    clip-path: polygon(0 0,100% 0,100% 12%,74% 12%,74% 17%,100% 17%,100% 31%,86% 31%,86% 38%,100% 38%,100% 54%,63% 54%,63% 60%,100% 60%,100% 100%,0 100%,0 76%,18% 76%,18% 69%,0 69%,0 46%,10% 46%,10% 39%,0 39%);
  }

  @media(max-width:760px){
    .archive-system-page{padding:34px 22px;background-size:79px 100%,121px 100%,171px 100%,auto}
    .archive-system-head{display:block}
    .archive-back{display:inline-block;margin-top:20px}
    .archive-row{grid-template-columns:1fr;gap:8px}
  }
</style>

<section class="archive-system-page panel">
  <div class="archive-system-inner">
    <header class="archive-system-head">
      <h1>Archivio</h1>
      <a class="archive-back" href="/ultimi-movimenti/">ultimi movimenti</a>
    </header>

    <div class="archive-chronology" aria-label="Archivio cronologico degli articoli">
      {% for post in collections.testi | reverse %}
      <a class="archive-row" href="{{ post.url }}">
        <time datetime="{{ post.data.date | dateISO }}">{{ post.data.date | dateISO }}</time>
        <strong>{{ post.data.title }}</strong>
        <em>{{ post.data.author }}</em>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
