---
layout: base.njk
title: Archivio | MANCUSPIE
permalink: /archivio/
---
<style>
  @import url('https://fonts.googleapis.com/css2?family=Metal+Mania&family=Pirata+One&display=swap');

  .archive-system-page {
    min-height: 100vh;
    background:
      radial-gradient(circle at 20% 0%, rgba(255,255,255,.08), transparent 22%),
      radial-gradient(circle at 78% 18%, rgba(0,0,0,.36), transparent 30%),
      linear-gradient(145deg, #8e0000 0%, #620000 38%, #2a0000 100%);
    padding: clamp(42px, 6vw, 88px);
    color: #f6eee4;
    overflow: hidden;
  }

  .archive-system-page::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      repeating-linear-gradient(92deg, rgba(0,0,0,.13) 0 1px, transparent 1px 7px),
      repeating-linear-gradient(178deg, rgba(255,255,255,.035) 0 1px, transparent 1px 11px);
    mix-blend-mode: multiply;
    opacity: .62;
  }

  .archive-system-page::after {
    content: "";
    position: absolute;
    left: -12vw;
    right: -12vw;
    bottom: -28vh;
    height: 52vh;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(0,0,0,.54), transparent 68%);
  }

  .archive-system-inner {
    position: relative;
    z-index: 4;
    max-width: 1120px;
    margin: 0 auto;
  }

  .archive-system-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid rgba(255,238,220,.36);
    padding-bottom: 22px;
    margin-bottom: clamp(28px, 4vw, 58px);
  }

  .archive-system-head h1 {
    margin: 0;
    font-family: 'Metal Mania', 'Pirata One', fantasy;
    font-size: clamp(72px, 13vw, 190px);
    line-height: .72;
    font-weight: 400;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: #fff8ee;
    text-shadow:
      0 3px 0 #1c0000,
      0 8px 16px rgba(0,0,0,.72),
      0 0 18px rgba(255,210,190,.20);
    transform: skewX(-4deg);
  }

  .archive-back {
    font: 300 11px/1 var(--font-sans);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #fff1df;
    border-bottom: 1px solid currentColor;
    padding-bottom: 7px;
    white-space: nowrap;
    text-shadow: 0 2px 6px rgba(0,0,0,.75);
  }

  .archive-chronology {
    display: grid;
    gap: 0;
  }

  .archive-row {
    display: grid;
    grid-template-columns: minmax(110px, 160px) 1fr minmax(110px, 180px);
    gap: clamp(18px, 3vw, 50px);
    align-items: baseline;
    padding: clamp(18px, 2.5vw, 32px) 0;
    border-bottom: 1px solid rgba(255,238,220,.24);
    color: #fff1df;
  }

  .archive-row time,
  .archive-row em {
    font: 300 12px/1.2 var(--font-sans);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: rgba(255,238,220,.72);
    font-style: normal;
  }

  .archive-row strong {
    font-family: 'Metal Mania', 'Pirata One', fantasy;
    font-size: clamp(34px, 5vw, 78px);
    line-height: .82;
    font-weight: 400;
    letter-spacing: .015em;
    text-transform: uppercase;
    color: #fff7eb;
    text-shadow:
      0 2px 0 #230000,
      0 7px 14px rgba(0,0,0,.62);
  }

  .archive-row:hover strong {
    color: #111;
    text-shadow:
      0 1px 0 rgba(255,255,255,.24),
      0 0 14px rgba(255,255,255,.35);
  }

  .archive-row:hover {
    background: rgba(255,238,220,.10);
  }

  @media(max-width:760px){
    .archive-system-page{padding:34px 22px}
    .archive-system-head{display:block}
    .archive-back{display:inline-block;margin-top:20px}
    .archive-row{grid-template-columns:1fr;gap:8px}
  }
</style>

<section class="archive-system-page panel">
  <div class="archive-system-inner">
    <header class="archive-system-head">
      <h1>Archivio</h1>
      <a class="archive-back" href="/ultimi-movimenti/">ultimi movimenti</a>
    </header>

    <div class="archive-chronology" aria-label="Archivio cronologico degli articoli">
      {% for post in collections.testi | reverse %}
      <a class="archive-row" href="{{ post.url }}">
        <time datetime="{{ post.data.date | dateISO }}">{{ post.data.date | dateISO }}</time>
        <strong>{{ post.data.title }}</strong>
        <em>{{ post.data.author }}</em>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
