---
layout: base.njk
title: Archivio | MANCUSPIE
permalink: /archivio/
---
<style>
  .archive-system-page {
    min-height: 100vh;
    background: #8b0000;
    padding: clamp(48px, 7vw, 104px);
    color: #050000;
    overflow: hidden;
  }

  .archive-system-page::before,
  .archive-system-page::after {
    display: none !important;
  }

  .archive-system-inner {
    position: relative;
    z-index: 4;
    max-width: 1180px;
    margin: 0 auto;
  }

  .archive-system-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: clamp(24px, 5vw, 80px);
    border-bottom: 1px solid rgba(5,0,0,.28);
    padding-bottom: clamp(24px, 4vw, 48px);
    margin-bottom: clamp(42px, 7vw, 96px);
  }

  .archive-system-head h1 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(54px, 8vw, 128px);
    line-height: .92;
    font-weight: 300;
    letter-spacing: .24em;
    text-transform: uppercase;
    color: #050000;
    -webkit-text-fill-color: #050000;
    -webkit-text-stroke: 0;
    text-shadow: none;
    transform: none;
    clip-path: none;
  }

  .archive-back {
    font: 300 11px/1 var(--font-sans);
    letter-spacing: .20em;
    text-transform: uppercase;
    color: #050000;
    border-bottom: 1px solid currentColor;
    padding-bottom: 8px;
    white-space: nowrap;
  }

  .archive-chronology {
    display: grid;
    gap: clamp(24px, 4vw, 52px);
  }

  .archive-row {
    display: grid;
    grid-template-columns: minmax(120px, 170px) 1fr minmax(120px, 190px);
    gap: clamp(24px, 5vw, 78px);
    align-items: baseline;
    padding: 0 0 clamp(22px, 3vw, 42px);
    border-bottom: 1px solid rgba(5,0,0,.20);
    color: #050000;
  }

  .archive-row time,
  .archive-row em {
    font: 300 11px/1.25 var(--font-sans);
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(5,0,0,.68);
    font-style: normal;
  }

  .archive-row strong {
    font-family: var(--font-sans);
    font-size: clamp(24px, 3.1vw, 48px);
    line-height: 1.04;
    font-weight: 300;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: #050000;
    -webkit-text-fill-color: #050000;
    display: inline-block;
    -webkit-text-stroke: 0;
    text-shadow: none;
    transform: none;
    clip-path: none;
  }

  .archive-row:hover {
    background: transparent;
  }

  .archive-row:hover strong {
    transform: translateX(8px);
    letter-spacing: .22em;
  }

  @media(max-width:760px){
    .archive-system-page{padding:38px 22px}
    .archive-system-head{display:block}
    .archive-system-head h1{font-size:clamp(40px,12vw,72px);letter-spacing:.16em}
    .archive-back{display:inline-block;margin-top:24px}
    .archive-row{grid-template-columns:1fr;gap:10px}
    .archive-row strong{font-size:clamp(24px,8vw,42px);letter-spacing:.12em}
  }
</style>

<section class="archive-system-page panel">
  <div class="archive-system-inner">
    <header class="archive-system-head">
      <h1>Archivio</h1>
      <a class="archive-back" href="/ultimi-movimenti/">ultimi movimenti</a>
    </header>

    <div class="archive-chronology" aria-label="Archivio cronologico degli articoli">
      {% for post in collections.testi | reverse %}
      <a class="archive-row" href="{{ post.url }}">
        <time datetime="{{ post.data.date | dateISO }}">{{ post.data.date | dateISO }}</time>
        <strong>{{ post.data.title }}</strong>
        <em>{{ post.data.author }}</em>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
