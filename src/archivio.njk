---
layout: base.njk
title: Archivio | MANCUSPIE
permalink: /archivio/
---
<style>
  .archive-system-page {
    min-height: 100vh;
    background:
      repeating-linear-gradient(90deg, transparent 0 31px, rgba(79, 0, 112, .16) 31px 32px, transparent 32px 83px),
      repeating-linear-gradient(90deg, transparent 0 67px, rgba(119, 35, 154, .11) 67px 68px, transparent 68px 151px),
      repeating-linear-gradient(90deg, transparent 0 109px, rgba(37, 0, 78, .20) 109px 110px, transparent 110px 229px),
      #8b0000;
    padding: clamp(42px, 6vw, 90px);
    color: #090000;
    overflow: hidden;
  }

  .archive-system-page::before,
  .archive-system-page::after { display: none !important; }

  .archive-bg-img {
    position: fixed;
    z-index: 1;
    right: clamp(-160px, -9vw, -52px);
    bottom: clamp(-120px, -7vw, -34px);
    width: clamp(620px, 66vw, 1120px);
    max-width: none;
    height: auto;
    pointer-events: none;
    opacity: 1;
  }

  .archive-system-inner {
    position: relative;
    z-index: 4;
    max-width: 1180px;
    margin: 0 auto;
  }

  .archive-system-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: clamp(24px, 5vw, 90px);
    border-bottom: 1px solid rgba(9,0,0,.34);
    padding-bottom: clamp(22px, 3.5vw, 44px);
    margin-bottom: clamp(38px, 6vw, 82px);
  }

  .archive-system-head h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(70px, 12vw, 174px);
    line-height: .78;
    font-weight: 300;
    letter-spacing: .045em;
    text-transform: uppercase;
    color: #090000;
    transform: none;
    transform-origin: left bottom;
    font-style: normal;
  }

  .archive-back {
    font: 300 11px/1 var(--font-sans);
    letter-spacing: .16em;
    text-transform: uppercase;
    color: #090000;
    border-bottom: 1px solid rgba(9,0,0,.55);
    padding-bottom: 8px;
    white-space: nowrap;
  }

  .archive-chronology { display: grid; gap: clamp(18px, 3vw, 42px); }

  .archive-row {
    display: grid;
    grid-template-columns: minmax(112px, 160px) 1fr minmax(108px, 170px);
    gap: clamp(20px, 4vw, 72px);
    align-items: baseline;
    padding: 0 0 clamp(20px, 2.8vw, 38px);
    border-bottom: 1px solid rgba(9,0,0,.28);
    color: #090000;
  }

  .archive-row time,
  .archive-row em {
    font: 300 11px/1.25 var(--font-sans);
    letter-spacing: .15em;
    text-transform: uppercase;
    color: rgba(9,0,0,.64);
    font-style: normal;
  }

  .archive-row strong {
    font-family: var(--font-serif);
    font-size: clamp(34px, 5.4vw, 82px);
    line-height: .86;
    font-weight: 300;
    letter-spacing: .018em;
    text-transform: uppercase;
    color: #090000;
    display: inline-block;
    font-style: normal;
    transform: none;
    transform-origin: left center;
  }

  .archive-row:nth-child(even) strong { letter-spacing: .04em; }
  .archive-row:hover { background: rgba(68,0,100,.10); }
  .archive-row:hover strong { transform: translateX(8px); }

  @media(max-width:760px){
    .archive-system-page{padding:34px 22px}
    .archive-bg-img{width:560px;right:-190px;bottom:-86px;opacity:1}
    .archive-system-head{display:block}
    .archive-system-head h1{font-size:clamp(50px,16vw,82px)}
    .archive-back{display:inline-block;margin-top:22px}
    .archive-row{grid-template-columns:1fr;gap:8px}
    .archive-row strong{font-size:clamp(34px,10vw,54px)}
  }
</style>

<section class="archive-system-page panel">
  <img class="archive-bg-img" src="/assets/img/b7db19117443e1ac718e6e183b5f7299-removebg-preview.png" alt="" aria-hidden="true">
  <div class="archive-system-inner">
    <header class="archive-system-head">
      <h1>Archivio</h1>
      <a class="archive-back" href="/ultimi-movimenti/">ultimi movimenti</a>
    </header>

    <div class="archive-chronology" aria-label="Archivio cronologico degli articoli">
      {% for post in collections.testi | reverse %}
      <a class="archive-row" href="{{ post.url }}">
        <time datetime="{{ post.data.date | dateISO }}">{{ post.data.date | dateISO }}</time>
        <strong>{{ post.data.title }}</strong>
        <em>{{ post.data.author }}</em>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
