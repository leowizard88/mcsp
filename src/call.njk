---
layout: base.njk
title: Call | MANCUSPIE
permalink: /call/
---
<section class="archive-page panel">
  <div class="archive-inner">
    <h1>Call</h1>
    {% for call in collections.call | reverse %}
    <a class="archive-item" href="{{ call.url }}">
      <span>{{ call.data.title }}</span><em>{{ call.data.status }} · {{ call.data.deadline }}</em><p>{{ call.data.excerpt }}</p>
    </a>
    {% endfor %}
  </div>
</section>
