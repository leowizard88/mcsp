---
layout: base.njk
title: Greed Island
---
<style>
  body:has(.greed-island-page), .site-main:has(.greed-island-page){background:#050000!important}
  .greed-island-page{min-height:100vh;margin:0;padding:clamp(18px,4vw,52px) 16px;display:grid;place-items:center;background:linear-gradient(rgba(0,0,0,.1),rgba(0,0,0,.34)),url('/assets/img/greed.jpg') center/cover no-repeat;color:#fff;overflow:hidden;font-family:'Courier New',monospace}
  .greed-card{width:min(720px,calc(100vw - var(--side,44px) - 36px));border:3px solid rgba(255,226,104,.95);background:rgba(9,20,18,.82);box-shadow:0 0 0 4px rgba(82,42,0,.8),10px 10px 0 rgba(0,0,0,.62),0 0 34px rgba(255,214,82,.32);backdrop-filter:blur(3px) saturate(1.25);padding:clamp(22px,4vw,42px)}
  .greed-card h1{margin:0 0 24px;text-align:center;font-family:Impact,Haettenschweiler,'Arial Black',serif;font-size:clamp(32px,5.6vw,68px);line-height:.95;text-transform:uppercase;letter-spacing:.04em;color:#ffe16a;-webkit-text-stroke:1px #3a1400;text-shadow:0 3px 0 #7c2d00,0 6px 0 #1a0700,0 0 18px rgba(255,212,72,.65)}
  .greed-form{display:grid;gap:14px}.greed-field{display:grid;gap:5px;text-align:left}.greed-field label{font:700 13px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.08em;color:#eaffc4;text-shadow:2px 2px 0 #000}
  .greed-field input,.greed-field select,.greed-field textarea{width:100%;box-sizing:border-box;border:2px solid rgba(255,226,104,.85);background:rgba(0,0,0,.72);color:#f5ffe8;font:15px/1.25 'Courier New',monospace;padding:10px 12px;outline:none;box-shadow:3px 3px 0 rgba(0,0,0,.7)}
  .greed-field textarea{min-height:92px;resize:vertical}.greed-submit{margin-top:8px;border:3px solid #132400;background:linear-gradient(180deg,#dcff65,#58b900 58%,#176000);color:#071400;font:900 17px/1 Impact,Haettenschweiler,'Arial Black',sans-serif;letter-spacing:.08em;text-transform:uppercase;padding:13px 18px;cursor:pointer;box-shadow:0 5px 0 #061400,0 0 22px rgba(152,255,47,.6)}
  .greed-game{display:none;position:fixed;inset:0;background:linear-gradient(rgba(0,0,0,.04),rgba(0,0,0,.18)),url('/assets/img/greed.jpg') center/cover no-repeat;z-index:5}
  .menu-button{position:fixed;top:18px;left:18px;z-index:30;border:2px solid #dfff73;background:rgba(0,24,8,.76);color:#dfff73;font:900 16px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.08em;padding:10px 13px;cursor:pointer;box-shadow:4px 4px 0 #000,0 0 18px rgba(142,255,67,.55)}
  .side-menu{position:fixed;top:0;left:0;bottom:0;width:min(320px,82vw);z-index:29;background:rgba(2,14,8,.92);border-right:3px solid #b8ff4a;box-shadow:8px 0 0 rgba(0,0,0,.72),0 0 34px rgba(103,255,55,.32);padding:72px 18px 18px;transform:translateX(-110%);transition:transform .18s ease;backdrop-filter:blur(3px)}
  body.menu-open .side-menu{transform:translateX(0)}
  .side-menu button{display:block;width:100%;margin:0 0 10px;border:2px solid rgba(255,255,255,.72);background:rgba(0,0,0,.52);color:#f2ffe6;text-align:left;font:900 16px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.06em;padding:13px 12px;cursor:pointer;box-shadow:3px 3px 0 #000}
  .side-menu button:hover{background:rgba(132,255,60,.28);color:#fff}
  .menu-panel{display:none;position:fixed;top:86px;left:min(360px,86vw);z-index:25;width:min(520px,calc(100vw - var(--side,44px) - 48px));max-height:calc(100vh - 126px);overflow:auto;border:2px solid rgba(223,255,115,.9);background:rgba(0,0,0,.7);box-shadow:7px 7px 0 rgba(0,0,0,.75),0 0 24px rgba(142,255,67,.35);padding:18px;color:#f4ffe8}
  body.menu-open .menu-panel.is-active{display:block}
  .menu-panel h2{margin:0 0 12px;color:#dfff73;font:900 28px/1 Impact,Haettenschweiler,'Arial Black',sans-serif;text-transform:uppercase;letter-spacing:.05em;text-shadow:3px 3px 0 #000}
  .menu-panel p,.menu-panel li{font-size:14px;line-height:1.35}.player-list{list-style:none;margin:0;padding:0;display:grid;gap:8px}.player-list li{border:1px solid rgba(255,255,255,.32);background:rgba(0,0,0,.45);padding:10px 11px;font-weight:900;color:#fff}
  .info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.info-item{border:1px solid rgba(255,255,255,.3);background:rgba(0,0,0,.45);padding:10px}.info-item strong{display:block;color:#ffe16a;text-transform:uppercase;font-size:11px;letter-spacing:.08em;margin-bottom:5px}.info-item.wide{grid-column:1/-1}
  .delete-character{display:none;position:fixed;right:14px;bottom:14px;z-index:30;border:1px solid #fff;background:rgba(120,0,18,.86);color:#fff;font:900 10px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.04em;padding:8px 9px;cursor:pointer;box-shadow:3px 3px 0 #000}
  body.has-greed-profile .greed-card{display:none}body.has-greed-profile .greed-game{display:block}body.has-greed-profile .delete-character{display:block}
  @media(max-width:760px){.greed-card{width:calc(100vw - var(--side,38px) - 28px)}.menu-panel{left:18px;top:250px;width:calc(100vw - var(--side,38px) - 36px)}.info-grid{grid-template-columns:1fr}}
</style>
<section class="greed-island-page" aria-label="Greed Island">
  <div class="greed-card">
    <h1>Crea il tuo personaggio</h1>
    <form class="greed-form" data-greed-form>
      <div class="greed-field"><label for="gi-name">Nome:</label><input id="gi-name" name="nome" required></div>
      <div class="greed-field"><label for="gi-surname">Cognome:</label><input id="gi-surname" name="cognome" required></div>
      <div class="greed-field"><label for="gi-age">Età:</label><input id="gi-age" name="eta" type="number" min="1" max="999" required></div>
      <div class="greed-field"><label for="gi-sex">Sesso:</label><select id="gi-sex" name="sesso" required><option value="">Scegli</option><option>Maschio</option><option>Femmina</option><option>Altro</option><option>Non specificato</option></select></div>
      <div class="greed-field"><label for="gi-story">Storia:</label><textarea id="gi-story" name="storia" required></textarea></div>
      <div class="greed-field"><label for="gi-nen">Abilità Nen:</label><textarea id="gi-nen" name="nen" required></textarea></div>
      <div class="greed-field"><label for="gi-author">Autore preferito:</label><input id="gi-author" name="autore" required></div>
      <button class="greed-submit" type="submit">Invia</button>
    </form>
  </div>
  <main class="greed-game" data-greed-game>
    <button class="menu-button" type="button" data-menu-toggle>Menù</button>
    <nav class="side-menu" aria-label="Menu Greed Island">
      <button type="button" data-panel="players">Giocatori</button>
      <button type="button" data-panel="explore">Esplora</button>
      <button type="button" data-panel="info">Info</button>
      <button type="button" data-panel="guide">Guida</button>
    </nav>
    <section class="menu-panel" data-menu-panel></section>
  </main>
  <button class="delete-character" type="button" data-delete-character>Elimina personaggio</button>
</section>
<script>
(() => {
  const key = 'greedIslandHxHProfile';
  const form = document.querySelector('[data-greed-form]');
  const del = document.querySelector('[data-delete-character]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.querySelector('[data-menu-panel]');
  const labels = { nome:'Nome', cognome:'Cognome', eta:'Età', sesso:'Sesso', storia:'Storia', nen:'Abilità Nen', autore:'Autore preferito' };
  const esc = s => String(s || '').replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
  const getProfile = () => { try { return JSON.parse(localStorage.getItem(key) || 'null'); } catch { return null; } };
  const renderState = () => { document.body.classList.toggle('has-greed-profile', !!getProfile()); };
  const infoHtml = data => `<h2>Info</h2><div class="info-grid">${Object.keys(labels).map(k => `<div class="info-item ${k === 'storia' || k === 'nen' ? 'wide' : ''}"><strong>${labels[k]}</strong><span>${esc(data[k])}</span></div>`).join('')}</div>`;
  const openPanel = name => {
    const data = getProfile();
    if (!data) return;
    if (name === 'players') panel.innerHTML = `<h2>Giocatori</h2><ul class="player-list"><li>${esc(data.nome)}</li></ul>`;
    if (name === 'explore') panel.innerHTML = '<h2>Esplora</h2><p>Modulo esplorazione da costruire.</p>';
    if (name === 'info') panel.innerHTML = infoHtml(data);
    if (name === 'guide') panel.innerHTML = '<h2>Guida</h2><p>Guida del gioco da scrivere.</p>';
    panel.classList.add('is-active');
  };
  renderState();
  form.addEventListener('submit', e => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    if (Object.values(data).some(v => !String(v).trim())) return;
    localStorage.setItem(key, JSON.stringify(data));
    renderState();
    history.pushState(null, '', '/greed-island/profilo/');
  });
  toggle.addEventListener('click', () => document.body.classList.toggle('menu-open'));
  document.querySelectorAll('[data-panel]').forEach(btn => btn.addEventListener('click', () => openPanel(btn.dataset.panel)));
  del.addEventListener('click', () => {
    localStorage.removeItem(key);
    form.reset();
    panel.classList.remove('is-active');
    document.body.classList.remove('menu-open');
    renderState();
    history.pushState(null, '', '/greed-island/');
  });
})();
</script>
