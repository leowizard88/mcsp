<style>
  body:has(.greed-island-page), .site-main:has(.greed-island-page){background:#050000!important}
  .greed-island-page{min-height:100vh;margin:0;padding:clamp(18px,4vw,52px) 16px;display:grid;place-items:center;background:linear-gradient(rgba(0,0,0,.1),rgba(0,0,0,.34)),url('/assets/img/greed.jpg') center/cover no-repeat;color:#fff;overflow:hidden;font-family:'Courier New',monospace}
  .login-warning{display:none;width:min(720px,calc(100vw - var(--side,44px) - 36px));border:3px solid #ff3030;background:rgba(20,0,0,.86);color:#fff;text-align:center;font:900 clamp(22px,4.6vw,54px)/1 Impact,Haettenschweiler,'Arial Black',sans-serif;text-transform:uppercase;letter-spacing:.035em;padding:clamp(24px,5vw,48px);box-shadow:0 0 0 5px #000,9px 9px 0 rgba(0,0,0,.74),0 0 30px rgba(255,0,0,.45);text-shadow:3px 3px 0 #000}
  .greed-card{width:min(720px,calc(100vw - var(--side,44px) - 36px));border:3px solid rgba(255,226,104,.95);background:rgba(9,20,18,.82);box-shadow:0 0 0 4px rgba(82,42,0,.8),10px 10px 0 rgba(0,0,0,.62),0 0 34px rgba(255,214,82,.32);backdrop-filter:blur(3px) saturate(1.25);padding:clamp(22px,4vw,42px)}
  .greed-card h1{margin:0 0 24px;text-align:center;font-family:Impact,Haettenschweiler,'Arial Black',serif;font-size:clamp(32px,5.6vw,68px);line-height:.95;text-transform:uppercase;letter-spacing:.04em;color:#ffe16a;-webkit-text-stroke:1px #3a1400;text-shadow:0 3px 0 #7c2d00,0 6px 0 #1a0700,0 0 18px rgba(255,212,72,.65)}
  .greed-form{display:grid;gap:14px}.greed-field{display:grid;gap:5px;text-align:left}.greed-field label{font:700 13px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.08em;color:#eaffc4;text-shadow:2px 2px 0 #000}
  .greed-field input,.greed-field select,.greed-field textarea{width:100%;box-sizing:border-box;border:2px solid rgba(255,226,104,.85);background:rgba(0,0,0,.72);color:#f5ffe8;font:15px/1.25 'Courier New',monospace;padding:10px 12px;outline:none;box-shadow:3px 3px 0 rgba(0,0,0,.7)}
  .greed-field textarea{min-height:92px;resize:vertical}.greed-submit{margin-top:8px;border:3px solid #132400;background:linear-gradient(180deg,#dcff65,#58b900 58%,#176000);color:#071400;font:900 17px/1 Impact,Haettenschweiler,'Arial Black',sans-serif;letter-spacing:.08em;text-transform:uppercase;padding:13px 18px;cursor:pointer;box-shadow:0 5px 0 #061400,0 0 22px rgba(152,255,47,.6)}
  .greed-game{display:none;position:fixed;inset:0;background:linear-gradient(rgba(0,0,0,.04),rgba(0,0,0,.18)),url('/assets/img/greed.jpg') center/cover no-repeat;z-index:5}
  .map-label{position:absolute;z-index:12;transform:translate(-50%,-50%);border:0;background:transparent;color:#8b0000;font-family:Georgia,'Times New Roman',serif;font-size:clamp(15px,2vw,27px);letter-spacing:.03em;text-transform:uppercase;text-shadow:0 1px 0 rgba(255,230,210,.65),0 0 5px rgba(255,255,255,.45);cursor:pointer;padding:4px 7px}.map-label:hover{color:#d00000;text-shadow:0 0 8px #fff,0 0 14px rgba(255,0,0,.55)}
  .map-label.can-go{color:#00a020;text-shadow:0 1px 0 #eaffd7,0 0 7px rgba(0,255,64,.72),0 0 14px rgba(0,80,20,.8)}.map-label.cant-go{color:#8b0000}.map-label.is-here{color:#ffe16a;text-shadow:0 1px 0 #000,0 0 8px #fff36a,0 0 18px rgba(255,225,80,.95)}
  .forest-label{font-family:'Courier New',monospace;font-size:clamp(12px,1.45vw,20px);font-weight:900;letter-spacing:.04em;color:#36115c;text-shadow:0 1px 0 #d8ffd8,0 0 7px rgba(0,0,0,.65);font-style:italic}.forest-label.can-go{color:#11802b;text-shadow:0 1px 0 #eaffd7,0 0 10px rgba(0,255,82,.72)}.forest-label.cant-go{color:#4d103e}.forest-label.is-here{color:#dfff73}
  .city-popup{display:none;position:fixed;z-index:28;left:50%;top:50%;transform:translate(-50%,-50%);width:min(360px,calc(100vw - var(--side,44px) - 36px));border:2px solid #ffe16a;background:rgba(4,14,10,.88);box-shadow:6px 6px 0 rgba(0,0,0,.75),0 0 28px rgba(255,225,106,.32);padding:18px;color:#f7ffe8}.city-popup.is-open{display:block}.city-popup h2{margin:0 0 10px;color:#ffe16a;font:900 30px/1 Impact,Haettenschweiler,'Arial Black',sans-serif;text-transform:uppercase;text-shadow:3px 3px 0 #000}.city-popup p{margin:0 0 14px;font:14px/1.35 'Courier New',monospace}.city-actions{display:flex;gap:9px;justify-content:flex-end}.city-actions button{border:1px solid #fff;background:#eaffff;color:#00131c;font:900 12px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.06em;padding:9px 11px;cursor:pointer}.city-actions [data-city-close]{background:#1b1b1b;color:#fff}.city-actions [hidden]{display:none!important}
  .menu-button{position:fixed;top:18px;left:calc(var(--side,44px) + 18px);z-index:30;border:2px solid #dfff73;background:rgba(0,24,8,.76);color:#dfff73;font:900 16px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.08em;padding:10px 13px;cursor:pointer;box-shadow:4px 4px 0 #000,0 0 18px rgba(142,255,67,.55)}
  .location-display{position:fixed;top:18px;left:calc(var(--side,44px) + 104px);z-index:30;border:2px solid rgba(255,255,255,.7);background:rgba(0,0,0,.58);color:#eaffd7;font:900 13px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.05em;padding:11px 12px;box-shadow:4px 4px 0 #000}.location-display strong{color:#dfff73}
  .side-menu{position:fixed;top:0;left:var(--side,44px);bottom:0;width:min(320px,calc(100vw - var(--side,44px) - 18px));z-index:29;background:rgba(2,14,8,.92);border-right:3px solid #b8ff4a;box-shadow:8px 0 0 rgba(0,0,0,.72),0 0 34px rgba(103,255,55,.32);padding:72px 18px 18px;transform:translateX(calc(-100% - 12px));transition:transform .18s ease;backdrop-filter:blur(3px)}body.menu-open .side-menu{transform:translateX(0)}
