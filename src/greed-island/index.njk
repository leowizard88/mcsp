---
layout: base.njk
title: Greed Island
---
<style>
  body:has(.greed-island-page), .site-main:has(.greed-island-page){background:#050000!important}
  .greed-island-page{min-height:100vh;margin:0;padding:clamp(18px,4vw,52px) 16px;display:grid;place-items:center;background:linear-gradient(rgba(0,0,0,.1),rgba(0,0,0,.34)),url('/assets/img/greed.jpg') center/cover no-repeat;color:#fff;overflow:hidden;font-family:'Courier New',monospace}
  .login-warning{display:none;width:min(720px,calc(100vw - var(--side,44px) - 36px));border:3px solid #ff3030;background:rgba(20,0,0,.86);color:#fff;text-align:center;font:900 clamp(22px,4.6vw,54px)/1 Impact,Haettenschweiler,'Arial Black',sans-serif;text-transform:uppercase;letter-spacing:.035em;padding:clamp(24px,5vw,48px);box-shadow:0 0 0 5px #000,9px 9px 0 rgba(0,0,0,.74),0 0 30px rgba(255,0,0,.45);text-shadow:3px 3px 0 #000}
  .greed-card{width:min(720px,calc(100vw - var(--side,44px) - 36px));border:3px solid rgba(255,226,104,.95);background:rgba(9,20,18,.82);box-shadow:0 0 0 4px rgba(82,42,0,.8),10px 10px 0 rgba(0,0,0,.62),0 0 34px rgba(255,214,82,.32);backdrop-filter:blur(3px) saturate(1.25);padding:clamp(22px,4vw,42px)}
  .greed-card h1{margin:0 0 24px;text-align:center;font-family:Impact,Haettenschweiler,'Arial Black',serif;font-size:clamp(32px,5.6vw,68px);line-height:.95;text-transform:uppercase;letter-spacing:.04em;color:#ffe16a;-webkit-text-stroke:1px #3a1400;text-shadow:0 3px 0 #7c2d00,0 6px 0 #1a0700,0 0 18px rgba(255,212,72,.65)}
  .greed-form{display:grid;gap:14px}.greed-field{display:grid;gap:5px;text-align:left}.greed-field label{font:700 13px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.08em;color:#eaffc4;text-shadow:2px 2px 0 #000}
  .greed-field input,.greed-field select,.greed-field textarea{width:100%;box-sizing:border-box;border:2px solid rgba(255,226,104,.85);background:rgba(0,0,0,.72);color:#f5ffe8;font:15px/1.25 'Courier New',monospace;padding:10px 12px;outline:none;box-shadow:3px 3px 0 rgba(0,0,0,.7)}
  .greed-field textarea{min-height:92px;resize:vertical}.greed-submit{margin-top:8px;border:3px solid #132400;background:linear-gradient(180deg,#dcff65,#58b900 58%,#176000);color:#071400;font:900 17px/1 Impact,Haettenschweiler,'Arial Black',sans-serif;letter-spacing:.08em;text-transform:uppercase;padding:13px 18px;cursor:pointer;box-shadow:0 5px 0 #061400,0 0 22px rgba(152,255,47,.6)}
  .greed-game{display:none;position:fixed;inset:0;background:linear-gradient(rgba(0,0,0,.04),rgba(0,0,0,.18)),url('/assets/img/greed.jpg') center/cover no-repeat;z-index:5}
  .map-label{position:absolute;z-index:12;transform:translate(-50%,-50%);border:0;background:transparent;color:#8b0000;font-family:Georgia,'Times New Roman',serif;font-size:clamp(15px,2vw,27px);letter-spacing:.03em;text-transform:uppercase;text-shadow:0 1px 0 rgba(255,230,210,.65),0 0 5px rgba(255,255,255,.45);cursor:pointer;padding:4px 7px}.map-label:hover{color:#d00000;text-shadow:0 0 8px #fff,0 0 14px rgba(255,0,0,.55)}
  .map-label.can-go{color:#00a020;text-shadow:0 1px 0 #eaffd7,0 0 7px rgba(0,255,64,.72),0 0 14px rgba(0,80,20,.8)}
  .map-label.cant-go{color:#8b0000}.map-label.is-here{color:#ffe16a;text-shadow:0 1px 0 #000,0 0 8px #fff36a,0 0 18px rgba(255,225,80,.95)}
  .forest-label{font-family:'Courier New',monospace;font-size:clamp(12px,1.45vw,20px);font-weight:900;letter-spacing:.04em;color:#36115c;text-shadow:0 1px 0 #d8ffd8,0 0 7px rgba(0,0,0,.65);font-style:italic}.forest-label.can-go{color:#11802b;text-shadow:0 1px 0 #eaffd7,0 0 10px rgba(0,255,82,.72)}.forest-label.cant-go{color:#4d103e}.forest-label.is-here{color:#dfff73}
  .city-popup{display:none;position:fixed;z-index:28;left:50%;top:50%;transform:translate(-50%,-50%);width:min(360px,calc(100vw - var(--side,44px) - 36px));border:2px solid #ffe16a;background:rgba(4,14,10,.88);box-shadow:6px 6px 0 rgba(0,0,0,.75),0 0 28px rgba(255,225,106,.32);padding:18px;color:#f7ffe8}.city-popup.is-open{display:block}.city-popup h2{margin:0 0 10px;color:#ffe16a;font:900 30px/1 Impact,Haettenschweiler,'Arial Black',sans-serif;text-transform:uppercase;text-shadow:3px 3px 0 #000}.city-popup p{margin:0 0 14px;font:14px/1.35 'Courier New',monospace}.city-actions{display:flex;gap:9px;justify-content:flex-end}.city-actions button{border:1px solid #fff;background:#eaffff;color:#00131c;font:900 12px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.06em;padding:9px 11px;cursor:pointer}.city-actions [data-city-close]{background:#1b1b1b;color:#fff}.city-actions [hidden]{display:none!important}
  .menu-button{position:fixed;top:18px;left:calc(var(--side,44px) + 18px);z-index:30;border:2px solid #dfff73;background:rgba(0,24,8,.76);color:#dfff73;font:900 16px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.08em;padding:10px 13px;cursor:pointer;box-shadow:4px 4px 0 #000,0 0 18px rgba(142,255,67,.55)}
  .location-display{position:fixed;top:18px;left:calc(var(--side,44px) + 104px);z-index:30;border:2px solid rgba(255,255,255,.7);background:rgba(0,0,0,.58);color:#eaffd7;font:900 13px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.05em;padding:11px 12px;box-shadow:4px 4px 0 #000}.location-display strong{color:#dfff73}
  .side-menu{position:fixed;top:0;left:var(--side,44px);bottom:0;width:min(320px,calc(100vw - var(--side,44px) - 18px));z-index:29;background:rgba(2,14,8,.92);border-right:3px solid #b8ff4a;box-shadow:8px 0 0 rgba(0,0,0,.72),0 0 34px rgba(103,255,55,.32);padding:72px 18px 18px;transform:translateX(calc(-100% - 12px));transition:transform .18s ease;backdrop-filter:blur(3px)}
  body.menu-open .side-menu{transform:translateX(0)}
  .side-menu button{display:block;width:100%;margin:0 0 10px;border:2px solid rgba(255,255,255,.72);background:rgba(0,0,0,.52);color:#f2ffe6;text-align:left;font:900 16px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.06em;padding:13px 12px;cursor:pointer;box-shadow:3px 3px 0 #000}.side-menu button:hover{background:rgba(132,255,60,.28);color:#fff}
  .menu-panel{display:none;position:fixed;top:86px;left:calc(var(--side,44px) + 360px);z-index:25;width:min(520px,calc(100vw - var(--side,44px) - 388px));max-height:calc(100vh - 126px);overflow:auto;border:2px solid rgba(223,255,115,.9);background:rgba(0,0,0,.7);box-shadow:7px 7px 0 rgba(0,0,0,.75),0 0 24px rgba(142,255,67,.35);padding:18px;color:#f4ffe8}
  body.menu-open .menu-panel.is-active{display:block}.menu-panel h2{margin:0 0 12px;color:#dfff73;font:900 28px/1 Impact,Haettenschweiler,'Arial Black',sans-serif;text-transform:uppercase;letter-spacing:.05em;text-shadow:3px 3px 0 #000}.menu-panel p,.menu-panel li{font-size:14px;line-height:1.35}.player-list{list-style:none;margin:0;padding:0;display:grid;gap:8px}.player-list li{border:1px solid rgba(255,255,255,.32);background:rgba(0,0,0,.45);padding:10px 11px;font-weight:900;color:#fff}
  .info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.info-item{border:1px solid rgba(255,255,255,.3);background:rgba(0,0,0,.45);padding:10px}.info-item strong{display:block;color:#ffe16a;text-transform:uppercase;font-size:11px;letter-spacing:.08em;margin-bottom:5px}.info-item.wide{grid-column:1/-1}
  .delete-character{display:none;position:fixed;right:14px;bottom:14px;z-index:30;border:1px solid #fff;background:rgba(120,0,18,.86);color:#fff;font:900 10px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.04em;padding:8px 9px;cursor:pointer;box-shadow:3px 3px 0 #000}
  body.greed-not-logged .login-warning{display:block}body.greed-not-logged .greed-card,body.greed-not-logged .greed-game,body.greed-not-logged .delete-character{display:none!important}
  body.has-greed-profile .greed-card{display:none}body.has-greed-profile .greed-game{display:block}body.has-greed-profile .delete-character{display:block}
  @media(max-width:760px){.greed-card,.login-warning{width:calc(100vw - var(--side,38px) - 28px)}.menu-button{left:calc(var(--side,38px) + 14px)}.location-display{top:62px;left:calc(var(--side,38px) + 14px)}.side-menu{left:var(--side,38px);width:calc(100vw - var(--side,38px) - 18px)}.menu-panel{left:calc(var(--side,38px) + 14px);top:250px;width:calc(100vw - var(--side,38px) - 36px)}.info-grid{grid-template-columns:1fr}.map-label{font-size:clamp(11px,3.1vw,18px)}}
</style>
<section class="greed-island-page" aria-label="Greed Island">
  <div class="login-warning" data-login-warning>NON SEI LOGGATO SU MANCUSPIE, FAI IL TUO ACCOUNT IN ALTO A DESTRA</div>
  <div class="greed-card"><h1>Crea il tuo personaggio</h1><form class="greed-form" data-greed-form><div class="greed-field"><label for="gi-name">Nome:</label><input id="gi-name" name="nome" required></div><div class="greed-field"><label for="gi-surname">Cognome:</label><input id="gi-surname" name="cognome" required></div><div class="greed-field"><label for="gi-age">Età:</label><input id="gi-age" name="eta" type="number" min="1" max="999" required></div><div class="greed-field"><label for="gi-sex">Sesso:</label><select id="gi-sex" name="sesso" required><option value="">Scegli</option><option>Maschio</option><option>Femmina</option><option>Altro</option><option>Non specificato</option></select></div><div class="greed-field"><label for="gi-story">Storia:</label><textarea id="gi-story" name="storia" required></textarea></div><div class="greed-field"><label for="gi-nen">Abilità Nen:</label><textarea id="gi-nen" name="nen" required></textarea></div><div class="greed-field"><label for="gi-author">Autore preferito:</label><input id="gi-author" name="autore" required></div><button class="greed-submit" type="submit">Invia</button></form></div>
  <main class="greed-game" data-greed-game>
    <button class="map-label" style="left:53%;top:40%" data-place="Masadora">Masadora</button><button class="map-label" style="left:89%;top:37%" data-place="Aiai">Aiai</button><button class="map-label" style="left:17%;top:33%" data-place="Soufrabi">Soufrabi</button><button class="map-label" style="left:61%;top:46%" data-place="Antokiba">Antokiba</button><button class="map-label" style="left:64%;top:62%" data-place="Dorias">Dorias</button><button class="map-label" style="left:73%;top:54%" data-place="Rubicuta">Rubicuta</button><button class="map-label" style="left:61%;top:26%" data-place="Limeiro">Limeiro</button><button class="map-label" style="left:28%;top:38%" data-place="Bunzen">Bunzen</button><button class="map-label forest-label" style="left:39%;top:39%" data-place="Foresta Oscura">Foresta Oscura</button>
    <button class="menu-button" type="button" data-menu-toggle>Menù</button><div class="location-display">Location: <strong data-location-label>Sperduto</strong></div><nav class="side-menu" aria-label="Menu Greed Island"><button type="button" data-panel="players">Giocatori</button><button type="button" data-panel="explore">Esplora</button><button type="button" data-panel="info">Info</button><button type="button" data-panel="guide">Guida</button></nav><section class="menu-panel" data-menu-panel></section><aside class="city-popup" data-city-popup><h2 data-city-title></h2><p data-city-info></p><div class="city-actions"><button type="button" data-city-close>Chiudi</button><button type="button" data-city-enter>Entra</button></div></aside>
  </main>
  <button class="delete-character" type="button" data-delete-character>Elimina personaggio</button>
</section>
<script>
(() => {
  const getMancuspieUser = () => {
    const token = localStorage.getItem('mancuspieAuthToken') || '';
    if (!token) return null;
    const name = localStorage.getItem('mancuspiePublicName') || 'utente-mancuspie';
    return { id: token.slice(-32) || token, name };
  };
  const account = getMancuspieUser();
  if (!account) { document.body.classList.add('greed-not-logged'); return; }
  const safeId = account.id.replace(/[^a-z0-9_.@-]/gi,'_');
  const key = 'greedIslandHxHProfile:' + safeId;
  const locKey = 'greedIslandLocation:' + safeId;
  const form = document.querySelector('[data-greed-form]');
  const del = document.querySelector('[data-delete-character]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.querySelector('[data-menu-panel]');
  const cityPopup = document.querySelector('[data-city-popup]');
  const cityTitle = document.querySelector('[data-city-title]');
  const cityInfo = document.querySelector('[data-city-info]');
  const cityEnter = document.querySelector('[data-city-enter]');
  const locationLabel = document.querySelector('[data-location-label]');
  let selectedPlace = '';
  const info = { Masadora:'Magic Town! Solo qui puoi comprare le carte incantesimo!', Aiai:"La città dell'amore... piena di amanti e di emozioni.", Soufrabi:'Piccola città portuale controllata dai pirati di Razor... brrr', Antokiba:'Città dei premi!! Concorsi diversi ogni settimana! Città iniziale per ogni player.', Dorias:"Gioco d'azzardo, prostitute, criminali e tanti soldi, ma anche tante carte.", Rubicuta:'Vicino a Antokiba, città tranquilla dove riposarsi.', Limeiro:'La capitale è accessibile solo con tutte le carte collezionate!', Bunzen:'Città piena di nebbia e mostri strani.', 'Foresta Oscura':'Prima location in cui di solito i giocatori cercano di fare soldi e carte' };
  const routes = { Sperduto:['Masadora'], Masadora:['Antokiba','Foresta Oscura'], Antokiba:['Masadora','Rubicuta','Dorias'], Rubicuta:['Dorias','Antokiba','Aiai'], Dorias:['Rubicuta','Antokiba'], Aiai:['Rubicuta'], 'Foresta Oscura':['Bunzen','Masadora'], Bunzen:['Foresta Oscura','Soufrabi'], Soufrabi:['Bunzen'], Limeiro:[] };
  const labels = { nome:'Nome', cognome:'Cognome', eta:'Età', sesso:'Sesso', storia:'Storia', nen:'Abilità Nen', autore:'Autore preferito' };
  const esc = s => String(s || '').replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
  const getProfile = () => { try { return JSON.parse(localStorage.getItem(key) || 'null'); } catch { return null; } };
  const getLoc = () => localStorage.getItem(locKey) || 'Sperduto';
  const canGo = place => place !== 'Limeiro' && (routes[getLoc()] || []).includes(place);
  const refreshMap = () => { const loc = getLoc(); locationLabel.textContent = loc; document.querySelectorAll('[data-place]').forEach(btn => { const place = btn.dataset.place; btn.classList.toggle('is-here', place === loc); btn.classList.toggle('can-go', place !== loc && canGo(place)); btn.classList.toggle('cant-go', place !== loc && !canGo(place)); }); };
  const renderState = () => { document.body.classList.remove('greed-not-logged'); document.body.classList.toggle('has-greed-profile', !!getProfile()); refreshMap(); };
  const infoHtml = data => `<h2>Info</h2><div class="info-grid">${Object.keys(labels).map(k => `<div class="info-item ${k === 'storia' || k === 'nen' ? 'wide' : ''}"><strong>${labels[k]}</strong><span>${esc(data[k])}</span></div>`).join('')}</div>`;
  const openPanel = name => { const data = getProfile(); if (!data) return; if (name === 'players') panel.innerHTML = `<h2>Giocatori</h2><ul class="player-list"><li>${esc(data.nome)}</li></ul>`; if (name === 'explore') panel.innerHTML = '<h2>Esplora</h2><p>Modulo esplorazione da costruire.</p>'; if (name === 'info') panel.innerHTML = infoHtml(data); if (name === 'guide') panel.innerHTML = '<h2>Guida</h2><p>Guida del gioco da scrivere.</p>'; panel.classList.add('is-active'); };
  renderState();
  form.addEventListener('submit', e => { e.preventDefault(); const data = Object.fromEntries(new FormData(form).entries()); if (Object.values(data).some(v => !String(v).trim())) return; data.ownerId = account.id; data.ownerName = account.name; localStorage.setItem(key, JSON.stringify(data)); if (!localStorage.getItem(locKey)) localStorage.setItem(locKey, 'Sperduto'); renderState(); history.pushState(null, '', '/greed-island/profilo/'); });
  toggle.addEventListener('click', () => document.body.classList.toggle('menu-open'));
  document.querySelectorAll('[data-panel]').forEach(btn => btn.addEventListener('click', () => openPanel(btn.dataset.panel)));
  document.querySelectorAll('[data-place]').forEach(btn => btn.addEventListener('click', () => { const name = btn.dataset.place; selectedPlace = ''; cityTitle.textContent = name; cityEnter.hidden = true; if (name === 'Limeiro') { cityInfo.textContent = info.Limeiro; } else if (!canGo(name) && getLoc() !== name) { cityInfo.textContent = 'non puoi arrivare qua a piedi da dove sei ora!'; } else { cityInfo.textContent = info[name] || ''; if (getLoc() !== name) { selectedPlace = name; cityEnter.hidden = false; } } cityPopup.classList.add('is-open'); }));
  document.querySelector('[data-city-close]').addEventListener('click', () => cityPopup.classList.remove('is-open'));
  cityEnter.addEventListener('click', () => { if (!selectedPlace) return; localStorage.setItem(locKey, selectedPlace); selectedPlace = ''; cityPopup.classList.remove('is-open'); refreshMap(); });
  del.addEventListener('click', () => { localStorage.removeItem(key); localStorage.removeItem(locKey); form.reset(); panel.classList.remove('is-active'); cityPopup.classList.remove('is-open'); document.body.classList.remove('menu-open'); renderState(); history.pushState(null, '', '/greed-island/'); });
})();
</script>
