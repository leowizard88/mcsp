  .menu-panel{display:none;position:fixed;top:86px;left:calc(var(--side,44px) + 360px);z-index:25;width:min(520px,calc(100vw - var(--side,44px) - 388px));max-height:calc(100vh - 126px);overflow:auto;border:2px solid rgba(223,255,115,.9);background:rgba(0,0,0,.7);box-shadow:7px 7px 0 rgba(0,0,0,.75),0 0 24px rgba(142,255,67,.35);padding:18px;color:#f4ffe8}body.menu-open .menu-panel.is-active{display:block}.menu-panel h2{margin:0 0 12px;color:#dfff73;font:900 28px/1 Impact,Haettenschweiler,'Arial Black',sans-serif;text-transform:uppercase;letter-spacing:.05em;text-shadow:3px 3px 0 #000}.menu-panel p,.menu-panel li{font-size:14px;line-height:1.35}.player-list{list-style:none;margin:0;padding:0;display:grid;gap:8px}.player-list li{border:1px solid rgba(255,255,255,.32);background:rgba(0,0,0,.45);padding:10px 11px;font-weight:900;color:#fff}
  .info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.info-item{border:1px solid rgba(255,255,255,.3);background:rgba(0,0,0,.45);padding:10px}.info-item strong{display:block;color:#ffe16a;text-transform:uppercase;font-size:11px;letter-spacing:.08em;margin-bottom:5px}.info-item.wide{grid-column:1/-1}
  .delete-character{display:none;position:fixed;right:14px;bottom:14px;z-index:30;border:1px solid #fff;background:rgba(120,0,18,.86);color:#fff;font:900 10px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.04em;padding:8px 9px;cursor:pointer;box-shadow:3px 3px 0 #000}
  body.greed-not-logged .login-warning{display:block}body.greed-not-logged .greed-card,body.greed-not-logged .greed-game,body.greed-not-logged .delete-character{display:none!important}body.has-greed-profile .greed-card{display:none}body.has-greed-profile .greed-game{display:block}body.has-greed-profile .delete-character{display:block}
  @media(max-width:760px){.greed-card,.login-warning{width:calc(100vw - var(--side,38px) - 28px)}.menu-button{left:calc(var(--side,38px) + 14px)}.location-display{top:62px;left:calc(var(--side,38px) + 14px)}.side-menu{left:var(--side,38px);width:calc(100vw - var(--side,38px) - 18px)}.menu-panel{left:calc(var(--side,38px) + 14px);top:250px;width:calc(100vw - var(--side,38px) - 36px)}.info-grid{grid-template-columns:1fr}.map-label{font-size:clamp(11px,3.1vw,18px)}}
</style>
<section class="greed-island-page" aria-label="Greed Island">
  <div class="login-warning" data-login-warning>NON SEI LOGGATO SU MANCUSPIE, FAI IL TUO ACCOUNT IN ALTO A DESTRA</div>
