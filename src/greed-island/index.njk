---
layout: base.njk
title: Greed Island
---
<style>
  body:has(.greed-island-page), .site-main:has(.greed-island-page){background:#050000!important}
  .greed-island-page{min-height:100vh;margin:0;padding:clamp(18px,4vw,52px) 16px;display:grid;place-items:center;background:linear-gradient(rgba(0,0,0,.18),rgba(0,0,0,.58)),url('/assets/img/greed.jpg') center/cover no-repeat;color:#fff;overflow:hidden;font-family:'Courier New',monospace}
  .greed-card{width:min(720px,calc(100vw - var(--side,44px) - 36px));border:3px solid rgba(255,226,104,.95);background:rgba(9,20,18,.82);box-shadow:0 0 0 4px rgba(82,42,0,.8),10px 10px 0 rgba(0,0,0,.62),0 0 34px rgba(255,214,82,.32);backdrop-filter:blur(3px) saturate(1.25);padding:clamp(22px,4vw,42px)}
  .greed-card h1{margin:0 0 24px;text-align:center;font-family:Impact,Haettenschweiler,'Arial Black',serif;font-size:clamp(32px,5.6vw,68px);line-height:.95;text-transform:uppercase;letter-spacing:.04em;color:#ffe16a;-webkit-text-stroke:1px #3a1400;text-shadow:0 3px 0 #7c2d00,0 6px 0 #1a0700,0 0 18px rgba(255,212,72,.65)}
  .greed-form{display:grid;gap:14px}
  .greed-field{display:grid;gap:5px;text-align:left}
  .greed-field label{font:700 13px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.08em;color:#eaffc4;text-shadow:2px 2px 0 #000}
  .greed-field input,.greed-field select,.greed-field textarea{width:100%;box-sizing:border-box;border:2px solid rgba(255,226,104,.85);background:rgba(0,0,0,.72);color:#f5ffe8;font:15px/1.25 'Courier New',monospace;padding:10px 12px;outline:none;box-shadow:3px 3px 0 rgba(0,0,0,.7)}
  .greed-field textarea{min-height:92px;resize:vertical}
  .greed-submit{margin-top:8px;border:3px solid #132400;background:linear-gradient(180deg,#dcff65,#58b900 58%,#176000);color:#071400;font:900 17px/1 Impact,Haettenschweiler,'Arial Black',sans-serif;letter-spacing:.08em;text-transform:uppercase;padding:13px 18px;cursor:pointer;box-shadow:0 5px 0 #061400,0 0 22px rgba(152,255,47,.6)}
  .greed-submit:hover{filter:saturate(1.2) brightness(1.06);transform:translateY(-1px)}
  .greed-profile{display:none;width:min(860px,calc(100vw - var(--side,44px) - 36px));border:3px solid rgba(142,255,67,.94);background:rgba(4,18,12,.84);box-shadow:0 0 0 4px #071800,12px 12px 0 rgba(0,0,0,.72),0 0 44px rgba(103,255,55,.4);padding:clamp(24px,4vw,46px)}
  .greed-profile h1{margin:0 0 18px;font-family:Impact,Haettenschweiler,'Arial Black',sans-serif;font-size:clamp(34px,6vw,82px);line-height:.9;text-transform:uppercase;color:#b8ff4a;-webkit-text-stroke:1px #061500;text-shadow:0 4px 0 #0b5d00,0 8px 0 #000,0 0 22px rgba(128,255,45,.85)}
  .profile-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:12px}
  .profile-item{border:1px solid rgba(255,255,255,.32);background:rgba(0,0,0,.48);padding:12px;min-height:54px}
  .profile-item strong{display:block;color:#ffe16a;text-transform:uppercase;font-size:12px;letter-spacing:.08em;margin-bottom:6px}
  .profile-item.wide{grid-column:1/-1}
  .delete-character{display:none;position:fixed;right:18px;bottom:18px;z-index:20;border:2px solid #fff;background:#b30018;color:#fff;font:900 13px/1 'Courier New',monospace;text-transform:uppercase;letter-spacing:.05em;padding:12px 14px;cursor:pointer;box-shadow:4px 4px 0 #000}
  .delete-character:hover{background:#ff0026}
  body.has-greed-profile .greed-card{display:none}
  body.has-greed-profile .greed-profile{display:block}
  body.has-greed-profile .delete-character{display:block}
  @media(max-width:760px){.profile-grid{grid-template-columns:1fr}.greed-card,.greed-profile{width:calc(100vw - var(--side,38px) - 28px)}}
</style>
<section class="greed-island-page" aria-label="Greed Island">
  <div class="greed-card">
    <h1>Crea il tuo personaggio</h1>
    <form class="greed-form" data-greed-form>
      <div class="greed-field"><label for="gi-name">Nome:</label><input id="gi-name" name="nome" required></div>
      <div class="greed-field"><label for="gi-surname">Cognome:</label><input id="gi-surname" name="cognome" required></div>
      <div class="greed-field"><label for="gi-age">Età:</label><input id="gi-age" name="eta" type="number" min="1" max="999" required></div>
      <div class="greed-field"><label for="gi-sex">Sesso:</label><select id="gi-sex" name="sesso" required><option value="">Scegli</option><option>Maschio</option><option>Femmina</option><option>Altro</option><option>Non specificato</option></select></div>
      <div class="greed-field"><label for="gi-story">Storia:</label><textarea id="gi-story" name="storia" required></textarea></div>
      <div class="greed-field"><label for="gi-nen">Abilità Nen:</label><textarea id="gi-nen" name="nen" required></textarea></div>
      <div class="greed-field"><label for="gi-author">Autore preferito:</label><input id="gi-author" name="autore" required></div>
      <button class="greed-submit" type="submit">Invia</button>
    </form>
  </div>
  <article class="greed-profile" data-greed-profile>
    <h1>Profilo HxH</h1>
    <div class="profile-grid" data-greed-profile-grid></div>
  </article>
  <button class="delete-character" type="button" data-delete-character>Elimina personaggio</button>
</section>
<script>
(() => {
  const key = 'greedIslandHxHProfile';
  const form = document.querySelector('[data-greed-form]');
  const grid = document.querySelector('[data-greed-profile-grid]');
  const del = document.querySelector('[data-delete-character]');
  const labels = { nome:'Nome', cognome:'Cognome', eta:'Età', sesso:'Sesso', storia:'Storia', nen:'Abilità Nen', autore:'Autore preferito' };
  const esc = s => String(s || '').replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
  const render = data => {
    if (!data) { document.body.classList.remove('has-greed-profile'); return; }
    grid.innerHTML = Object.keys(labels).map(k => `<div class="profile-item ${k === 'storia' || k === 'nen' ? 'wide' : ''}"><strong>${labels[k]}</strong><span>${esc(data[k])}</span></div>`).join('');
    document.body.classList.add('has-greed-profile');
  };
  try { render(JSON.parse(localStorage.getItem(key) || 'null')); } catch { render(null); }
  form.addEventListener('submit', e => {
    e.preventDefault();
    const data = Object.fromEntries(new FormData(form).entries());
    if (Object.values(data).some(v => !String(v).trim())) return;
    localStorage.setItem(key, JSON.stringify(data));
    render(data);
    history.pushState(null, '', '/greed-island/profilo/');
  });
  del.addEventListener('click', () => {
    localStorage.removeItem(key);
    form.reset();
    render(null);
    history.pushState(null, '', '/greed-island/');
  });
})();
</script>
