---
layout: base.njk
title: MANCUSPIE
---
<style>
  @import url('https://fonts.googleapis.com/css2?family=Gaegu:wght@300;400&display=swap');

  body { background: #e6d0a8 !important; }
  .site-main { background: #e6d0a8 !important; }
  .panel { background: #e6d0a8 !important; }
  .panel::before { background: linear-gradient(115deg, #ead8b6, #d8bd8b) !important; }
  .hero-panel::before { display: block !important; background: linear-gradient(115deg, #ead8b6, #d8bd8b) !important; }
  .hero-panel::after { display: none !important; }
  .call-panel::before, .testi-panel::before, .note-panel::before, .noi-panel::before, .projects-panel::before { background: linear-gradient(115deg, #ead8b6, #d8bd8b) !important; }
  .bg-score { transform: rotate(0deg) !important; }

  .hero-copy { max-width: min(980px, 86vw); }

  .hero-copy h2 {
    font-size: clamp(22px, 2.45vw, 42px) !important;
    line-height: 1.05 !important;
    letter-spacing: .035em !important;
    margin-top: 13px !important;
    margin-bottom: 18px !important;
    margin-left: clamp(104px, 12.2vw, 184px) !important;
    max-width: min(570px, 58vw) !important;
  }

  .hero-copy .child-title {
    display: inline-block;
    max-width: 100%;
    font-family: 'Gaegu', 'Comic Sans MS', cursive;
    font-size: clamp(78px, 12.2vw, 184px);
    line-height: .76;
    letter-spacing: -.075em;
    font-weight: 300;
    margin: 0 0 22px;
    color: #050505;
    text-transform: uppercase;
    white-space: nowrap;
    background: none;
    -webkit-background-clip: initial;
    background-clip: initial;
    -webkit-text-fill-color: #050505;
    -webkit-text-stroke: 0;
    text-shadow: none;
    filter: none;
  }

  .child-title span { display: inline-block; transform-origin: 50% 70%; opacity: 1; }
  .child-title .l1 { transform: rotate(-5deg) translateY(4px) scaleX(.92); }
  .child-title .l2 { transform: rotate(3deg) translateY(-7px) scaleX(.90); opacity:1; }
  .child-title .l3 { transform: scaleX(-.92) rotate(-7deg) translateY(8px); margin: 0 .006em; opacity:1; }
  .child-title .l4 { transform: rotate(6deg) translateY(-2px) scaleX(.90); opacity:1; }
  .child-title .l5 { transform: rotate(-3deg) translateY(6px) scaleX(.92); opacity:1; }
  .child-title .l6 { transform: rotate(4deg) translateY(-5px) scaleX(.90); opacity:1; }
  .child-title .l7 { transform: rotate(-6deg) translateY(4px) scaleX(.90); opacity:1; }
  .child-title .l8 { transform: rotate(2deg) translateY(-3px) scaleX(.80); opacity:1; }
  .child-title .l9 { transform: rotate(-4deg) translateY(5px) scaleX(.88); opacity:1; }

  .ultimi-movimenti-button {
    position: absolute;
    right: clamp(14px, 4vw, 58px);
    bottom: clamp(14px, 5vw, 66px);
    z-index: 9;
    display: block;
    width: clamp(340px, 32vw, 560px) !important;
    opacity: .94;
    mix-blend-mode: multiply;
    transform-origin: 60% 72%;
    overflow: visible;
  }
  .ultimi-movimenti-button img {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
    filter: contrast(1.05) saturate(.82);
  }
  .latest-drama-spine {
    position: absolute;
    left: 6.5%;
    top: -6%;
    width: 119%;
    height: 119%;
    z-index: 3;
    pointer-events: none;
    overflow: visible;
    mix-blend-mode: multiply;
  }
  .latest-drama-spine text {
    font-family: 'Gaegu', 'Comic Sans MS', cursive;
    font-size: 56px;
    font-weight: 300;
    letter-spacing: .09em;
    fill: #050505;
    stroke: rgba(230,208,168,.42);
    stroke-width: .9px;
    paint-order: stroke fill;
  }
  .ultimi-movimenti-button:hover { animation: movimentiVibra .115s steps(2, end) infinite; opacity: 1; }
  @keyframes movimentiVibra {
    0% { transform: translate(0, 0) rotate(-1deg); }
    25% { transform: translate(2px, -1px) rotate(1.2deg); }
    50% { transform: translate(-2px, 1px) rotate(-.8deg); }
    75% { transform: translate(1px, 2px) rotate(.7deg); }
    100% { transform: translate(-1px, 0) rotate(-1.1deg); }
  }
  @media(max-width:760px){
    .hero-copy{max-width:calc(100vw - 78px)}
    .hero-copy .child-title{font-size:clamp(49px,13.2vw,64px);letter-spacing:-.09em;white-space:nowrap}
    .hero-copy h2{font-size:18px !important;letter-spacing:.025em !important;margin-top:10px !important;margin-bottom:14px !important;margin-left:42px !important;max-width:calc(100vw - 124px) !important}
    .ultimi-movimenti-button{width:238px !important;right:8px;bottom:16px;opacity:.9}
    .latest-drama-spine{left:7.5%;top:-8%;width:124%;height:124%}
    .latest-drama-spine text{font-size:54px;letter-spacing:.10em}
  }
</style>

<section id="home" class="panel hero-panel">
  <div class="bg-layer bg-daisies"></div>
  <div class="bg-layer bg-mechanical"></div>
  <div class="bg-layer bg-score"></div>
  <div class="bg-layer bg-figure"></div>
  <div class="hero-copy">
    <p class="eyebrow">{{ home.hero_note }}</p>
    <h1 class="child-title" aria-label="MANCUSPIE"><span class="l1">M</span><span class="l2">A</span><span class="l3">N</span><span class="l4">C</span><span class="l5">U</span><span class="l6">S</span><span class="l7">P</span><span class="l8">I</span><span class="l9">E</span></h1>
    <div class="hairline"></div>
    <h2>Cosa c'è da dire? Ci sono amici furbi e amici stolti così come ci sono gatte e cani, culi e culetti - stronzi e maghi. Noi siamo dalla parte dei culetti pur rimanendo cani e stronzi (abbiamo qualche mago come minoranza). #FuckCats #FuckDogs #PayRespectTo2025</h2>
  </div>
  <a class="ultimi-movimenti-button" href="/ultimi-movimenti/" aria-label="Vai a Ultimi movimenti">
    <img alt="Figura" src="/assets/img/adfe1ddc4e68f7828ffef4e2737ca5a2.jpg">
    <svg class="latest-drama-spine" viewBox="0 0 680 680" aria-hidden="true" focusable="false">
      <defs>
        <path id="latestDramaBack" d="M456 86 C574 138 624 266 592 374 C565 465 488 543 374 598" />
      </defs>
      <text>
        <textPath href="#latestDramaBack" startOffset="7%">LATEST DRAMA</textPath>
      </text>
    </svg>
  </a>
</section>

<section id="call" class="panel content-panel call-panel">
  <div class="bg-layer bg-fog"></div>
  <article class="section-block wide">
    <p class="section-kicker">01</p>
    <h2>{{ home.call_title }}</h2>
    <p>{{ home.call_text }}</p>
    <p class="meta">Scadenza: {{ home.call_deadline }}</p>
    {% for call in collections.call | reverse %}
      {% if loop.index0 < 1 %}<a class="text-link" href="{{ call.url }}">Leggi il bando &rarr;</a>{% endif %}
    {% endfor %}
  </article>
</section>

<section id="testi" class="panel content-panel testi-panel">
  <div class="bg-layer bg-tree"></div>
  <article class="section-block list-block">
    <p class="section-kicker">02</p>
    <h2>Testi in primo piano</h2>
    <div class="item-list">
      {% for post in collections.testi | reverse %}
      {% if loop.index0 < 4 %}
      <a class="item" href="{{ post.url }}"><span>{{ post.data.title }}</span><em>{{ post.data.author }}</em></a>
      {% endif %}
      {% endfor %}
    </div>
  </article>
</section>

<section id="note" class="panel content-panel note-panel">
  <div class="bg-layer bg-sigils"></div>
  <article class="section-block list-block offset-right">
    <p class="section-kicker">03</p>
    <h2>Manifesti</h2>
    <div class="item-list">
      {% for post in collections.note | reverse %}
      {% if loop.index0 < 4 %}
      <a class="item" href="{{ post.url }}"><span>{{ post.data.title }}</span><em>{{ post.data.author }}</em></a>
      {% endif %}
      {% endfor %}
    </div>
  </article>
</section>

<section id="noi" class="panel content-panel noi-panel">
  <div class="bg-layer bg-archive"></div>
  <article class="section-block wide">
    <p class="section-kicker">04</p>
    <h2>Noi</h2>
    <p>{{ home.noi_text }}</p>
    <a class="text-link" href="/noi/">Chi siamo &rarr;</a>
  </article>
</section>

<section id="progetti" class="panel content-panel projects-panel">
  <div class="bg-layer bg-spine"></div>
  <article class="section-block list-block">
    <p class="section-kicker">05</p>
    <h2>Altri progetti</h2>
    <div class="item-list">
      {% for project in collections.progetti | reverse %}
      {% if loop.index0 < 4 %}
      <a class="item" href="{{ project.url }}"><span>{{ project.data.title }}</span><em>{{ project.data.excerpt }}</em></a>
      {% endif %}
      {% endfor %}
    </div>
  </article>
  <footer class="footer"><span>© MANCUSPIE</span><span>{{ site.email }}</span><span>{{ home.newsletter_text }}</span></footer>
</section>
