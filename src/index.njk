---
layout: base.njk
title: MANCUSPIE
---
<style>
  .ultimi-movimenti-button {
    position: absolute;
    right: clamp(24px, 5vw, 76px);
    bottom: clamp(26px, 6vw, 82px);
    z-index: 9;
    display: block;
    width: clamp(150px, 15vw, 235px);
    opacity: .88;
    mix-blend-mode: multiply;
    transform-origin: 60% 72%;
  }

  .ultimi-movimenti-button svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .ultimi-movimenti-button:hover {
    animation: movimentiVibra .115s steps(2, end) infinite;
    opacity: 1;
  }

  .ultimi-movimenti-button:hover .movimenti-line {
    stroke-width: 5.2;
  }

  @keyframes movimentiVibra {
    0% { transform: translate(0, 0) rotate(-1deg); }
    25% { transform: translate(2px, -1px) rotate(1.2deg); }
    50% { transform: translate(-2px, 1px) rotate(-.8deg); }
    75% { transform: translate(1px, 2px) rotate(.7deg); }
    100% { transform: translate(-1px, 0) rotate(-1.1deg); }
  }

  @media(max-width:760px){
    .ultimi-movimenti-button{width:126px;right:18px;bottom:24px;opacity:.78}
  }
</style>

