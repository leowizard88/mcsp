---
layout: base.njk
title: Materiali vari | MANCUSPIE
permalink: /materiali/
---
{% set materials = collections.materiali or [] %}
<style>
body:has(.materiali-page),body:has(.materiali-page) .site-main{background:#ddd5c4!important}.materiali-page{position:relative;min-height:100vh;box-sizing:border-box;overflow:hidden;padding:clamp(32px,7vw,104px);color:#090000;background:#ddd5c4!important}.materiali-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;z-index:0}.materiali-page::after{content:"";position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,rgba(255,253,244,.26),rgba(255,253,244,.07) 58%,rgba(255,253,244,.1))}.materiali-inner{position:relative;z-index:2;max-width:min(930px,86vw)}.materiali-kicker{margin:0 0 18px;font:500 11px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.22em;text-transform:uppercase;color:#090000}.materiali-title{margin:0;font:300 clamp(68px,13.8vw,176px)/.76 var(--font-serif,Georgia,serif);letter-spacing:-.055em;text-transform:uppercase;color:#090000}.materiali-rule{width:min(360px,72vw);height:1px;margin:clamp(24px,4vw,45px) 0 18px;background:#090000}.materiali-subtitle{max-width:560px;margin:0;color:#090000;font:300 clamp(20px,2.4vw,34px)/1.1 var(--font-serif,Georgia,serif)}.materiali-filters{display:grid;gap:10px;max-width:680px;margin-top:clamp(44px,7vw,82px);padding:14px 0;border-top:1px solid rgba(9,0,0,.55);border-bottom:1px solid rgba(9,0,0,.55)}.materiali-filter-row{display:flex;gap:7px;flex-wrap:wrap}.materiali-filter{border:1px solid #8b0000;background:rgba(255,253,244,.72);color:#8b0000;padding:8px 10px;font:700 10px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.12em;text-transform:uppercase;cursor:pointer}.materiali-filter.is-active{color:#fff8e8;background:#8b0000}.materiali-list{display:grid;gap:0;max-width:680px;background:rgba(255,253,244,.78)}.materiale{padding:18px 16px 20px;border-bottom:1px solid rgba(139,0,0,.34);color:#8b0000}.materiale[hidden]{display:none}.materiale-title{display:inline;color:#8b0000;font:300 clamp(28px,4vw,48px)/.96 var(--font-serif,Georgia,serif);letter-spacing:-.035em;text-decoration:none}.materiale-title:hover{text-decoration:underline}.materiale-link{margin-left:8px;color:#8b0000;font:700 10px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.12em;text-transform:uppercase}.materiale-meta{margin:12px 0 0;color:rgba(139,0,0,.78);font:600 10px/1.4 var(--font-sans,system-ui,sans-serif);letter-spacing:.13em;text-transform:uppercase}.materiale-description{max-width:600px;margin:10px 0 0;color:#8b0000;font:300 18px/1.25 var(--font-serif,Georgia,serif)}.materiali-empty{margin:clamp(48px,8vw,100px) 0 0;color:#8b0000;font:300 28px/1.1 var(--font-serif,Georgia,serif)}.materiali-back{display:inline-block;margin-top:36px;color:#090000;border-bottom:1px solid currentColor;padding-bottom:7px;font:500 11px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.16em;text-transform:uppercase;text-decoration:none}@media(max-width:700px){.materiali-page{padding:30px 24px}.materiali-photo{object-position:58% center}.materiali-inner{max-width:min(510px,91vw)}.materiali-title{font-size:clamp(60px,18vw,100px)}.materiali-subtitle{font-size:22px}.materiale-title{font-size:34px}}
</style>
<section class="materiali-page panel">
  <img class="materiali-photo" src="/assets/img/materiali-vari.svg" alt="" aria-hidden="true">
  <div class="materiali-inner">
    <p class="materiali-kicker">Altri progetti</p><h1 class="materiali-title">MATERIALI VARI</h1><div class="materiali-rule"></div><p class="materiali-subtitle">Cose che ci piacciono o che vogliamo mettere a disposizione del mondo.</p>
    {% if materials.length %}
    <div class="materiali-filters" data-material-filters><div class="materiali-filter-row"><button class="materiali-filter is-active" type="button" data-type="">Tutti</button><button class="materiali-filter" type="button" data-type="libro">Libri</button><button class="materiali-filter" type="button" data-type="sito">Siti</button><button class="materiali-filter" type="button" data-type="video">Video</button><button class="materiali-filter" type="button" data-type="altro">Altro</button></div><div class="materiali-filter-row" data-category-filters></div></div>
    <div class="materiali-list" aria-label="Archivio materiali">
      {% for material in materials | reverse %}
      {% set isReader = material.data.resource_format == 'pdf' or material.data.resource_format == 'epub' %}{% set target = isReader ? '/lettore-materiali/?file=' + material.data.resource_url + '&type=' + material.data.resource_format : material.data.resource_url %}
      <article class="materiale" data-material data-type="{{ material.data.tipo or 'altro' }}" data-category="{{ material.data.category or '' }}">
        <a class="materiale-title" href="{{ target }}"{% if material.data.resource_kind == 'link' and not isReader %} target="_blank" rel="noopener"{% elif material.data.resource_kind == 'file' and not isReader %} download{% endif %}>{{ material.data.title }}</a>{% if material.data.resource_name %}<a class="materiale-link" href="{{ target }}"{% if material.data.resource_kind == 'link' and not isReader %} target="_blank" rel="noopener"{% elif material.data.resource_kind == 'file' and not isReader %} download{% endif %}>{{ material.data.resource_name }}</a>{% endif %}
        <p class="materiale-meta">{{ material.data.date | dateISO }} · {{ material.data.author }} · {{ material.data.tipo or 'altro' }}{% if material.data.category %} · {{ material.data.category }}{% endif %}</p>{% if material.data.description %}<p class="materiale-description">{{ material.data.description }}</p>{% endif %}
      </article>
      {% endfor %}
    </div>
    {% else %}<p class="materiali-empty">L’archivio è appena cominciato.</p>{% endif %}
    <a class="materiali-back" href="/progetti/">Altri progetti</a>
  </div>
</section>
<script>
(() => {const cards=[...document.querySelectorAll('[data-material]')],categoryBox=document.querySelector('[data-category-filters]');if(!cards.length||!categoryBox)return;const esc=v=>String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const categories=[...new Set(cards.map(c=>c.dataset.category).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'it'));if(categories.length)categoryBox.innerHTML='<button class="materiali-filter is-active" type="button" data-category="">Tutte le categorie</button>'+categories.map(c=>'<button class="materiali-filter" type="button" data-category="'+esc(c)+'">'+esc(c)+'</button>').join('');let type='',category='';const render=()=>{document.querySelectorAll('[data-type]').forEach(b=>b.classList.toggle('is-active',b.dataset.type===type));document.querySelectorAll('[data-category]').forEach(b=>b.classList.toggle('is-active',b.dataset.category===category));cards.forEach(c=>c.hidden=!!((type&&c.dataset.type!==type)||(category&&c.dataset.category!==category)))};document.querySelector('[data-material-filters]').addEventListener('click',e=>{const b=e.target.closest('button');if(!b)return;if(b.hasAttribute('data-type'))type=b.dataset.type;if(b.hasAttribute('data-category'))category=b.dataset.category;render()});})();
</script>