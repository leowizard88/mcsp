---
layout: base.njk
title: Materiali vari | MANCUSPIE
permalink: /materiali/
---
{% set materials = collections.materiali or [] %}
<style>
  body:has(.materiali-page), body:has(.materiali-page) .site-main { background:#191915!important; }
  .materiali-page{position:relative;min-height:100vh;box-sizing:border-box;overflow:hidden;padding:clamp(32px,7vw,104px);color:#fffdf4;background:linear-gradient(90deg,rgba(11,13,13,.82) 0%,rgba(11,13,13,.58) 42%,rgba(11,13,13,.2) 76%,rgba(11,13,13,.28) 100%),url('/assets/img/materiali-vari.svg') center/cover no-repeat}.materiali-page::after{content:"";position:absolute;inset:0;pointer-events:none;background:repeating-linear-gradient(0deg,rgba(255,255,255,.035) 0 1px,transparent 1px 5px);mix-blend-mode:overlay}.materiali-inner{position:relative;z-index:1;max-width:min(900px,84vw)}.materiali-kicker{margin:0 0 18px;font:400 11px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.22em;text-transform:uppercase}.materiali-title{margin:0;font:300 clamp(68px,13.8vw,176px)/.76 var(--font-serif,Georgia,serif);letter-spacing:-.055em;text-transform:uppercase}.materiali-rule{width:min(360px,72vw);height:1px;margin:clamp(24px,4vw,45px) 0 18px;background:rgba(255,253,244,.76)}.materiali-subtitle{max-width:560px;margin:0;font:300 clamp(20px,2.4vw,34px)/1.1 var(--font-serif,Georgia,serif)}.materiali-list{display:grid;gap:0;max-width:680px;margin-top:clamp(48px,8vw,100px);border-top:1px solid rgba(255,253,244,.48)}.materiale{padding:18px 0 20px;border-bottom:1px solid rgba(255,253,244,.38)}.materiale-title{display:inline;font:300 clamp(28px,4vw,48px)/.96 var(--font-serif,Georgia,serif);letter-spacing:-.035em;color:#fffdf4;text-decoration:none}.materiale-title:hover{text-decoration:underline}.materiale-link{margin-left:8px;color:#fffdf4;font:400 10px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.12em;text-transform:uppercase}.materiale-meta{margin:12px 0 0;color:rgba(255,253,244,.8);font:400 10px/1.4 var(--font-sans,system-ui,sans-serif);letter-spacing:.13em;text-transform:uppercase}.materiale-description{max-width:600px;margin:10px 0 0;font:300 18px/1.25 var(--font-serif,Georgia,serif)}.materiali-empty{margin:clamp(48px,8vw,100px) 0 0;font:300 28px/1.1 var(--font-serif,Georgia,serif)}.materiali-back{display:inline-block;margin-top:clamp(36px,7vw,84px);color:inherit;border-bottom:1px solid currentColor;padding-bottom:7px;font:400 11px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.16em;text-transform:uppercase;text-decoration:none}@media(max-width:700px){.materiali-page{padding:30px 24px;background-position:58% center}.materiali-inner{max-width:min(510px,91vw)}.materiali-title{font-size:clamp(60px,18vw,100px)}.materiali-subtitle{font-size:22px}.materiale-title{font-size:34px}}
</style>
<section class="materiali-page panel">
  <div class="materiali-inner">
    <p class="materiali-kicker">Altri progetti</p>
    <h1 class="materiali-title">MATERIALI VARI</h1>
    <div class="materiali-rule"></div>
    <p class="materiali-subtitle">Cose che ci piacciono o che vogliamo mettere a disposizione del mondo.</p>
    {% if materials.length %}
    <div class="materiali-list" aria-label="Archivio materiali">
      {% for material in materials | reverse %}
      {% set isReader = material.data.resource_format == 'pdf' or material.data.resource_format == 'epub' %}
      {% set target = isReader ? '/lettore-materiali/?file=' + material.data.resource_url + '&type=' + material.data.resource_format : material.data.resource_url %}
      <article class="materiale">
        <a class="materiale-title" href="{{ target }}"{% if material.data.resource_kind == 'link' and not isReader %} target="_blank" rel="noopener"{% elif material.data.resource_kind == 'file' and not isReader %} download{% endif %}>{{ material.data.title }}</a>
        {% if material.data.resource_name %}<a class="materiale-link" href="{{ target }}"{% if material.data.resource_kind == 'link' and not isReader %} target="_blank" rel="noopener"{% elif material.data.resource_kind == 'file' and not isReader %} download{% endif %}>{{ material.data.resource_name }}</a>{% endif %}
        <p class="materiale-meta">{{ material.data.date | dateISO }} · {{ material.data.author }}</p>
        {% if material.data.description %}<p class="materiale-description">{{ material.data.description }}</p>{% endif %}
      </article>
      {% endfor %}
    </div>
    {% else %}
    <p class="materiali-empty">L’archivio è appena cominciato.</p>
    {% endif %}
    <a class="materiali-back" href="/progetti/">Altri progetti</a>
  </div>
</section>
