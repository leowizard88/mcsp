---
layout: base.njk
title: Profilo | MANCUSPIE
permalink: /profilo/
---
<section class="profile-page panel">
  <div class="profile-card" data-profile-root>
    <p class="eyebrow">Account</p>
    <h1>Profilo</h1>
    <p class="profile-status">Caricamento profilo...</p>
  </div>
</section>

<style>
  .profile-page {
    min-height: 100vh;
    background: #fbfaf5 !important;
    color: #050505;
    padding: clamp(34px, 6vw, 86px);
    display: block !important;
  }

  .profile-card {
    max-width: 820px;
    margin: 0 auto;
    color: #050505;
  }

  .profile-card h1 {
    margin: 0 0 22px;
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(62px, 10vw, 132px);
    line-height: .82;
    font-weight: 300;
    text-transform: uppercase;
    color: #050505;
  }

  .profile-box {
    border-top: 1px solid rgba(5,5,5,.34);
    padding-top: 24px;
    display: grid;
    gap: 16px;
  }

  .profile-username {
    font: 300 clamp(32px, 5vw, 58px)/1 var(--font-serif, Georgia, serif);
    margin: 0;
    letter-spacing: -.035em;
    color: #050505;
  }

  .profile-avatar {
    width: 148px;
    height: 148px;
    border: 1px solid rgba(5,5,5,.42);
    object-fit: cover;
    background: rgba(5,5,5,.08);
  }

  .profile-avatar[src=""] {
    display: none;
  }

  .profile-card label {
    display: grid;
    gap: 7px;
    font: 300 11px/1 var(--font-sans, system-ui, sans-serif);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #050505;
  }

  .profile-card textarea,
  .profile-card input[type="text"],
  .profile-card input[type="file"] {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(5,5,5,.34);
    background: rgba(255,255,255,.46);
    color: #050505;
    padding: 12px;
    font: 16px/1.35 var(--font-sans, system-ui, sans-serif);
  }

  .profile-card textarea {
    min-height: 160px;
    resize: vertical;
  }

  .profile-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .profile-actions button,
  .profile-actions a,
  .profile-login-link {
    border: 1px solid #050505;
    background: #050505;
    color: #fbfaf5;
    padding: 11px 13px;
    font: 300 11px/1 var(--font-sans, system-ui, sans-serif);
    letter-spacing: .15em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
  }

  .profile-status {
    min-height: 18px;
    color: #6d0000;
    font: 15px/1.35 var(--font-sans, system-ui, sans-serif);
  }

  @media(max-width:760px) {
    .profile-page { padding: 34px 20px; }
    .profile-card h1 { font-size: clamp(54px, 18vw, 84px); }
  }
</style>

<script>
(() => {
  const root = document.querySelector('[data-profile-root]');
  const tokenKey = 'mancuspieAuthToken';
  const token = () => localStorage.getItem(tokenKey) || '';
  const esc = value => String(value || '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
  const headers = () => token() ? { authorization: `Bearer ${token()}` } : {};
  const fileToDataUrl = file => new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result);
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });

  const loggedOut = message => {
    root.innerHTML = `
      <p class="eyebrow">Account</p>
      <h1>Profilo</h1>
      <p class="profile-status">${esc(message || 'Non risulti loggato su questo browser.')}</p>
      <a class="profile-login-link" href="/">Torna alla home e accedi dall’icona</a>`;
  };

  const renderUser = user => {
    root.innerHTML = `
      <p class="eyebrow">Account</p>
      <h1>Profilo</h1>
      <form class="profile-box" data-profile-form>
        <p class="profile-username">${esc(user.username)}</p>
        <img class="profile-avatar" data-profile-avatar src="${esc(user.avatar || '')}" alt="Foto profilo">
        <label>Foto profilo <input data-avatar-input name="avatar" type="file" accept="image/png,image/jpeg,image/webp,image/gif"></label>
        <label>Descrizione <textarea data-bio-input name="bio" maxlength="900" placeholder="scrivi una piccola bacheca personale">${esc(user.bio || '')}</textarea></label>
        <label>SEC <input data-sec-input name="sec" type="text" maxlength="120" value="${esc(user.sec || '')}" placeholder="codice SEC"></label>
        <p class="profile-status" data-profile-status></p>
        <div class="profile-actions"><button type="submit">Salva</button><button type="button" data-logout>Logout</button><a href="/">Home</a></div>
      </form>`;

    const form = root.querySelector('[data-profile-form]');
    const status = root.querySelector('[data-profile-status]');
    const avatarInput = root.querySelector('[data-avatar-input]');
    const bioInput = root.querySelector('[data-bio-input]');
    const secInput = root.querySelector('[data-sec-input]');
    const avatarPreview = root.querySelector('[data-profile-avatar]');
    let avatar = user.avatar || '';

    avatarInput.addEventListener('change', async () => {
      if (!avatarInput.files || !avatarInput.files[0]) return;
      avatar = await fileToDataUrl(avatarInput.files[0]);
      avatarPreview.src = avatar;
      avatarPreview.style.display = 'block';
    });

    form.addEventListener('submit', async event => {
      event.preventDefault();
      status.textContent = 'Salvataggio...';
      const body = { action: 'update', bio: bioInput.value, sec: secInput.value, avatar };
      const response = await fetch('/api/auth', { method: 'POST', headers: { 'content-type': 'application/json', ...headers() }, body: JSON.stringify(body) });
      const result = await response.json().catch(() => ({}));
      status.textContent = response.ok ? 'Profilo salvato.' : (result.error || 'Errore salvataggio.');
    });

    root.querySelector('[data-logout]').addEventListener('click', async () => {
      await fetch('/api/auth', { method: 'POST', headers: { 'content-type': 'application/json', ...headers() }, body: JSON.stringify({ action: 'logout' }) });
      localStorage.removeItem(tokenKey);
      localStorage.setItem('mancuspiePublicName', 'Anonimo');
      location.href = '/';
    });
  };

  const load = async () => {
    if (!token()) {
      loggedOut('Qui non c’è nessuna sessione salvata. Rifai il login dalla home.');
      return;
    }
    const response = await fetch('/api/auth', { headers: headers(), cache: 'no-store' });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) {
      loggedOut(data.error || 'Sessione non valida. Rifai il login dalla home.');
      return;
    }
    if (!data.user) {
      loggedOut('Sessione assente o scaduta. Rifai il login dalla home.');
      return;
    }
    renderUser(data.user);
  };

  load().catch(error => {
    root.innerHTML = `<p class="eyebrow">Account</p><h1>Profilo</h1><p class="profile-status">Profilo non disponibile: ${esc(error.message)}</p><a class="profile-login-link" href="/">Home</a>`;
  });
})();
</script>
