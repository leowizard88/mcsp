---
layout: base.njk
title: Profilo | MANCUSPIE
permalink: /profilo/
---
<section class="profile-page panel">
  <div class="profile-card" data-profile-root>
    <p class="eyebrow">Account</p>
    <h1>Profilo</h1>
    <p class="profile-status">Caricamento profilo...</p>
  </div>
</section>

<style>
  body:has(.profile-page),
  body:has(.profile-page) .site-main {
    background: #050000 !important;
  }

  .profile-page {
    min-height: 100vh;
    color: #ead7b3;
    padding: clamp(34px, 6vw, 86px);
    display: block !important;
    background:
      radial-gradient(circle at 18% 20%, rgba(234, 215, 179, .18), transparent 26%),
      radial-gradient(circle at 78% 80%, rgba(5, 0, 0, .74), transparent 42%),
      linear-gradient(128deg, #8b0000 0%, #4d0000 44%, #050000 100%) !important;
    overflow: hidden;
  }

  .profile-page::after {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(90deg, transparent 0 34px, rgba(234,215,179,.06) 34px 35px, transparent 35px 96px),
      repeating-linear-gradient(0deg, transparent 0 44px, rgba(234,215,179,.035) 44px 45px, transparent 45px 112px);
    opacity: .8;
  }

  .profile-card {
    position: relative;
    z-index: 2;
    max-width: 940px;
    margin: 0 auto;
    color: #ead7b3;
  }

  .profile-card .eyebrow {
    color: rgba(234,215,179,.78);
    letter-spacing: .18em;
  }

  .profile-card h1 {
    margin: 0 0 clamp(24px, 4vw, 42px);
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(78px, 13vw, 172px);
    line-height: .76;
    font-weight: 300;
    letter-spacing: -.05em;
    text-transform: uppercase;
    color: #ead7b3;
    text-shadow: 0 0 28px rgba(234,215,179,.22);
  }

  .profile-box {
    display: grid;
    gap: 18px;
    max-width: 780px;
    background:
      linear-gradient(90deg, rgba(5,0,0,.40), rgba(5,0,0,.16)),
      rgba(234,215,179,.075);
    padding: clamp(22px, 4vw, 34px);
    box-shadow: none !important;
    border: 0 !important;
  }

  .profile-public-box {
    max-width: 720px;
  }

  .profile-username {
    font: 300 clamp(42px, 6.5vw, 82px)/.92 var(--font-serif, Georgia, serif);
    margin: 0;
    letter-spacing: -.045em;
    color: #ead7b3;
  }

  .profile-role {
    justify-self: start;
    margin: -8px 0 0;
    padding: 0;
    border: 0 !important;
    font: 300 11px/1 var(--font-sans, system-ui, sans-serif);
    letter-spacing: .18em;
    text-transform: uppercase;
    color: rgba(234,215,179,.72);
  }

  .profile-avatar {
    width: 158px;
    height: 158px;
    border: 0 !important;
    object-fit: cover;
    background: transparent !important;
    box-shadow: none !important;
  }

  .profile-avatar[src=""] {
    display: none;
  }

  .profile-bio-public {
    margin: 0;
    max-width: 680px;
    white-space: pre-wrap;
    font: 300 clamp(22px,2.4vw,32px)/1.22 var(--font-serif, Georgia, serif);
    color: rgba(234,215,179,.88);
  }

  .profile-card label {
    display: grid;
    gap: 8px;
    font: 300 11px/1 var(--font-sans, system-ui, sans-serif);
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(234,215,179,.82);
  }

  .profile-card textarea,
  .profile-card input[type="text"],
  .profile-card input[type="file"] {
    width: 100%;
    box-sizing: border-box;
    border: 0 !important;
    background: rgba(5,0,0,.48);
    color: #ead7b3;
    padding: 14px;
    font: 16px/1.35 var(--font-sans, system-ui, sans-serif);
    outline: none;
    box-shadow: none !important;
  }

  .profile-card textarea:focus,
  .profile-card input[type="text"]:focus {
    background: rgba(5,0,0,.70);
  }

  .profile-card textarea::placeholder,
  .profile-card input::placeholder {
    color: rgba(234,215,179,.45);
  }

  .profile-card textarea {
    min-height: 160px;
    resize: vertical;
  }

  .profile-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }

  .profile-actions button,
  .profile-actions a,
  .profile-login-link {
    border: 0 !important;
    background: #ead7b3;
    color: #050000;
    padding: 12px 14px;
    font: 300 11px/1 var(--font-sans, system-ui, sans-serif);
    letter-spacing: .15em;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    box-shadow: none !important;
  }

  .profile-actions button[data-logout] {
    background: #050000;
    color: #fbfaf5;
  }

  .profile-status {
    min-height: 18px;
    color: #ffb19c;
    font: 15px/1.35 var(--font-sans, system-ui, sans-serif);
  }

  .sec-box {
    border: 0 !important;
    padding-top: 8px;
    display: grid;
    gap: 10px;
  }

  .sec-box p {
    margin: 0;
    max-width: 620px;
    color: rgba(234,215,179,.70);
    font: 14px/1.4 var(--font-sans, system-ui, sans-serif);
  }

  .sec-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    align-items: end;
  }

  .writer-link {
    background: #fbfaf5 !important;
    color: #050000 !important;
  }

  @media(max-width:760px) {
    .profile-page {
      padding: 34px 20px;
    }
    .profile-card h1 {
      font-size: clamp(64px, 19vw, 96px);
    }
    .profile-box {
      padding: 20px;
      box-shadow: none !important;
    }
    .sec-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
(() => {
  const root = document.querySelector('[data-profile-root]');
  const tokenKey = 'mancuspieAuthToken';
  const token = () => localStorage.getItem(tokenKey) || '';
  const esc = value => String(value || '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
  const headers = () => token() ? { authorization: `Bearer ${token()}` } : {};
  const viewedUsername = new URLSearchParams(location.search).get('u') || '';
  const fileToDataUrl = file => new Promise((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(reader.result); reader.onerror = reject; reader.readAsDataURL(file); });

  const roleLabel = user => user?.isRedattore ? 'redattore' : 'user';

  const loggedOut = message => {
    root.innerHTML = `<p class="eyebrow">Account</p><h1>Profilo</h1><p class="profile-status">${esc(message || 'Non risulti loggato su questo browser.')}</p><a class="profile-login-link" href="/">Torna alla home e accedi dall’icona</a>`;
  };

  const renderPublicUser = user => {
    root.innerHTML = `
      <p class="eyebrow">Profilo pubblico</p>
      <h1>Profilo</h1>
      <div class="profile-box profile-public-box">
        <p class="profile-username">${esc(user.username)}</p>
        <p class="profile-role">${esc(roleLabel(user))}</p>
        <img class="profile-avatar" src="${esc(user.avatar || '')}" alt="Foto profilo">
        <p class="profile-bio-public">${esc(user.bio || 'Nessuna descrizione pubblicata.')}</p>
        <div class="profile-actions"><a href="/">Home</a></div>
      </div>`;
  };

  const renderOwnUser = user => {
    const redattoreTools = user.isRedattore
      ? `<div class="profile-actions"><a class="writer-link" href="/scrivi/">Scrivi un articolo</a></div>`
      : `<div class="sec-box"><label>Codice SEC <div class="sec-row"><input data-sec-code type="text" maxlength="120" placeholder="codice monouso"><button type="button" data-sec-submit>Invia codice</button></div></label><p>Il codice SEC monouso abilita il permesso redattore.</p></div>`;

    root.innerHTML = `
      <p class="eyebrow">Account</p>
      <h1>Profilo</h1>
      <form class="profile-box" data-profile-form>
        <p class="profile-username">${esc(user.username)}</p>
        <p class="profile-role">${esc(roleLabel(user))}</p>
        <img class="profile-avatar" data-profile-avatar src="${esc(user.avatar || '')}" alt="Foto profilo">
        <label>Foto profilo <input data-avatar-input name="avatar" type="file" accept="image/png,image/jpeg,image/webp,image/gif"></label>
        <label>Descrizione <textarea data-bio-input name="bio" maxlength="900" placeholder="scrivi una piccola bacheca personale">${esc(user.bio || '')}</textarea></label>
        ${redattoreTools}
        <p class="profile-status" data-profile-status></p>
        <div class="profile-actions"><button type="submit">Salva</button><button type="button" data-logout>Logout</button><a href="/">Home</a></div>
      </form>`;

    const form = root.querySelector('[data-profile-form]');
    const status = root.querySelector('[data-profile-status]');
    const avatarInput = root.querySelector('[data-avatar-input]');
    const bioInput = root.querySelector('[data-bio-input]');
    const avatarPreview = root.querySelector('[data-profile-avatar]');
    let avatar = user.avatar || '';

    avatarInput.addEventListener('change', async () => { if (!avatarInput.files || !avatarInput.files[0]) return; avatar = await fileToDataUrl(avatarInput.files[0]); avatarPreview.src = avatar; avatarPreview.style.display = 'block'; });

    form.addEventListener('submit', async event => {
      event.preventDefault();
      status.textContent = 'Salvataggio...';
      const body = { action: 'update', bio: bioInput.value, avatar };
      const response = await fetch('/api/auth', { method: 'POST', headers: { 'content-type': 'application/json', ...headers() }, body: JSON.stringify(body) });
      const result = await response.json().catch(() => ({}));
      status.textContent = response.ok ? 'Profilo salvato.' : (result.error || 'Errore salvataggio.');
    });

    const secButton = root.querySelector('[data-sec-submit]');
    secButton?.addEventListener('click', async () => {
      const code = root.querySelector('[data-sec-code]')?.value || '';
      status.textContent = 'Verifica codice SEC...';
      const response = await fetch('/api/auth', { method: 'POST', headers: { 'content-type': 'application/json', ...headers() }, body: JSON.stringify({ action: 'redeemsec', code }) });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) { status.textContent = result.error || 'Codice non valido.'; return; }
      status.textContent = 'Permesso redattore attivato.';
      setTimeout(() => renderOwnUser(result.user), 350);
    });

    root.querySelector('[data-logout]').addEventListener('click', async () => { await fetch('/api/auth', { method: 'POST', headers: { 'content-type': 'application/json', ...headers() }, body: JSON.stringify({ action: 'logout' }) }); localStorage.removeItem(tokenKey); localStorage.setItem('mancuspiePublicName', 'Anonimo'); location.href = '/'; });
  };

  const load = async () => {
    const url = viewedUsername ? `/api/auth?username=${encodeURIComponent(viewedUsername)}` : '/api/auth';
    if (!viewedUsername && !token()) { loggedOut('Qui non c’è nessuna sessione salvata. Rifai il login dalla home.'); return; }
    const response = await fetch(url, { headers: headers(), cache: 'no-store' });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) { root.innerHTML = `<p class="eyebrow">Account</p><h1>Profilo</h1><p class="profile-status">${esc(data.error || 'Profilo non trovato.')}</p><a class="profile-login-link" href="/">Home</a>`; return; }
    if (!data.user) { loggedOut('Sessione assente o scaduta. Rifai il login dalla home.'); return; }
    if (data.user.canEdit) renderOwnUser(data.user); else renderPublicUser(data.user);
  };

  load().catch(error => { root.innerHTML = `<p class="eyebrow">Account</p><h1>Profilo</h1><p class="profile-status">Profilo non disponibile: ${esc(error.message)}</p><a class="profile-login-link" href="/">Home</a>`; });
})();
</script>
