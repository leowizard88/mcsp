---
layout: base.njk
title: Quoteboard | MANCUSPIE
permalink: /quoteboard/
---
<section class="quote-page panel">
  <div class="quote-shell" data-quote-root>
    <p class="quote-kicker">Quoteboard</p>
    <h1>Citazioni</h1>
    <p class="quote-status">Caricamento...</p>
  </div>
</section>

<style>
  body:has(.quote-page), body:has(.quote-page) .site-main { background:#120000!important; }
  .quote-page{min-height:100vh;color:#f0dcc0;padding:clamp(28px,5.8vw,78px);background:linear-gradient(135deg,#260000,#780000 48%,#160000)!important;position:relative;overflow:hidden}.quote-page::before{content:"";position:fixed;inset:0;pointer-events:none;background:repeating-linear-gradient(90deg,transparent 0 52px,rgba(240,220,192,.055) 52px 53px,transparent 53px 126px);opacity:.65}.quote-shell{position:relative;z-index:2;width:min(1000px,100%);margin:0 auto}.quote-kicker{margin:0 0 10px;color:rgba(240,220,192,.72);font:300 11px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.22em;text-transform:uppercase}.quote-shell>h1{margin:0 0 30px;color:#f0dcc0;font:300 clamp(70px,12vw,158px)/.76 var(--font-serif,Georgia,serif);letter-spacing:-.06em;text-transform:uppercase}.quote-head{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin:0 0 22px}.quote-owner{margin:0;color:#f0dcc0;font:300 clamp(28px,4.8vw,64px)/.9 var(--font-serif,Georgia,serif);letter-spacing:-.04em}.quote-actions{display:flex;gap:10px;flex-wrap:wrap}.quote-actions a,.quote-actions button,.quote-add-button{border:0;background:#f0dcc0;color:#260000;padding:12px 14px;font:800 12px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.13em;text-transform:uppercase;text-decoration:none;cursor:pointer}.quote-add-button{font-size:24px;line-height:.7;padding:12px 16px}.quote-status{min-height:18px;margin:0;color:#ffd0bd;font:15px/1.35 var(--font-sans,system-ui,sans-serif)}.quote-list{display:grid;gap:14px;margin:22px 0 0;padding:0;list-style:none}.quote-card{background:rgba(20,0,0,.38);padding:clamp(16px,3vw,28px);border:1px solid rgba(240,220,192,.16)}.quote-card-head{display:flex;gap:12px;align-items:flex-start;justify-content:space-between}.quote-text{margin:0;color:#f0dcc0;font:300 clamp(25px,3.6vw,44px)/1.08 var(--font-serif,Georgia,serif);letter-spacing:-.025em;white-space:pre-wrap}.quote-delete{flex:0 0 auto;border:1px solid rgba(240,220,192,.28);background:rgba(240,220,192,.1);color:#f0dcc0;padding:8px 10px;font:800 10px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.13em;text-transform:uppercase;cursor:pointer}.quote-delete:hover{background:#f0dcc0;color:#260000}.quote-meta{margin:14px 0 0;color:rgba(240,220,192,.68);font:700 11px/1.35 var(--font-sans,system-ui,sans-serif);letter-spacing:.12em;text-transform:uppercase}.quote-modal{position:fixed;inset:0;z-index:80;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(5,0,0,.72)}.quote-modal.is-open{display:flex}.quote-box{width:min(620px,100%);background:#f0dcc0;color:#260000;padding:24px;box-shadow:0 22px 70px rgba(0,0,0,.35)}.quote-box h2{margin:0 0 16px;font:300 46px/.9 var(--font-serif,Georgia,serif);letter-spacing:-.04em}.quote-form{display:grid;gap:12px}.quote-field{display:grid;gap:7px;font:800 11px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.13em;text-transform:uppercase}.quote-field input,.quote-field textarea{width:100%;box-sizing:border-box;border:0;background:rgba(38,0,0,.12);color:#260000;padding:13px;font:16px/1.35 var(--font-sans,system-ui,sans-serif);outline:none}.quote-field textarea{min-height:150px;resize:vertical}.quote-form-actions{display:flex;gap:10px;flex-wrap:wrap}.quote-form-actions button{border:0;background:#260000;color:#f0dcc0;padding:12px 14px;font:800 11px/1 var(--font-sans,system-ui,sans-serif);letter-spacing:.13em;text-transform:uppercase;cursor:pointer}.quote-form-actions button[type="button"]{background:rgba(38,0,0,.18);color:#260000}@media(max-width:760px){.quote-page{padding:34px 18px}.quote-shell>h1{font-size:clamp(58px,18vw,92px)}.quote-head{align-items:flex-start}.quote-card{padding:16px}.quote-text{font-size:26px}.quote-box{padding:18px}}
</style>

<script>
(() => {
  const root = document.querySelector('[data-quote-root]');
  const tokenKey = 'mancuspieAuthToken';
  const token = () => localStorage.getItem(tokenKey) || '';
  const params = new URLSearchParams(location.search);
  const username = String(params.get('u') || params.get('username') || '').trim();
  const esc = value => String(value || '').replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char]));
  const headers = () => token() ? { authorization:`Bearer ${token()}` } : {};
  const meta = item => [item.author, item.book].filter(Boolean).map(esc).join(' / ');
  let currentOwner = username;

  const renderShell = data => {
    currentOwner = data.owner?.username || username;
    const quotes = Array.isArray(data.quotes) ? data.quotes : [];
    const cards = quotes.map(item => `<li class="quote-card"><div class="quote-card-head"><p class="quote-text">“${esc(item.quote)}”</p>${data.canAdd ? `<button class="quote-delete" type="button" data-delete-quote="${esc(item.id)}">Rimuovi</button>` : ''}</div>${meta(item) ? `<p class="quote-meta">${meta(item)}</p>` : ''}</li>`).join('');
    root.innerHTML = `<p class="quote-kicker">Quoteboard</p><h1>Citazioni</h1><div class="quote-head"><p class="quote-owner">${esc(currentOwner)}</p><div class="quote-actions"><a href="/profilo/?u=${encodeURIComponent(currentOwner)}">Profilo</a>${data.canAdd ? '<button class="quote-add-button" type="button" data-open-quote>+</button>' : ''}</div></div><p class="quote-status" data-quote-status>${quotes.length ? '' : 'Nessuna citazione ancora.'}</p><ul class="quote-list">${cards}</ul>${data.canAdd ? modalHtml() : ''}`;
    root.querySelector('[data-open-quote]')?.addEventListener('click', () => root.querySelector('[data-quote-modal]')?.classList.add('is-open'));
    root.querySelector('[data-close-quote]')?.addEventListener('click', () => root.querySelector('[data-quote-modal]')?.classList.remove('is-open'));
    root.querySelector('[data-quote-form]')?.addEventListener('submit', addQuote);
    root.querySelectorAll('[data-delete-quote]').forEach(button => button.addEventListener('click', deleteQuote));
  };

  const modalHtml = () => `<div class="quote-modal" data-quote-modal><div class="quote-box"><h2>Nuova citazione</h2><form class="quote-form" data-quote-form><label class="quote-field">Citazione:<textarea name="quote" maxlength="900" required></textarea></label><label class="quote-field">Autore:<input name="author" type="text" maxlength="120"></label><label class="quote-field">Libro:<input name="book" type="text" maxlength="160"></label><p class="quote-status" data-modal-status></p><div class="quote-form-actions"><button type="submit">Aggiungi</button><button type="button" data-close-quote>Chiudi</button></div></form></div></div>`;

  const addQuote = async event => {
    event.preventDefault();
    const form = event.currentTarget;
    const status = root.querySelector('[data-modal-status]');
    status.textContent = 'Salvataggio...';
    const body = { quote:form.quote.value, author:form.author.value, book:form.book.value };
    const response = await fetch('/api/quotes', { method:'POST', headers:{ 'content-type':'application/json', ...headers() }, body:JSON.stringify(body) });
    const result = await response.json().catch(() => ({}));
    if (!response.ok) { status.textContent = result.error || 'Errore.'; return; }
    await load();
  };

  const deleteQuote = async event => {
    const id = event.currentTarget.getAttribute('data-delete-quote');
    const status = root.querySelector('[data-quote-status]');
    status.textContent = 'Rimozione...';
    const response = await fetch(`/api/quotes?id=${encodeURIComponent(id)}`, { method:'DELETE', headers:headers() });
    const result = await response.json().catch(() => ({}));
    if (!response.ok) { status.textContent = result.error || 'Errore.'; return; }
    await load();
  };

  const load = async () => {
    let target = username;
    if (!target && token()) {
      const me = await fetch('/api/auth', { headers:headers(), cache:'no-store' }).then(r => r.json()).catch(() => ({}));
      target = me.user?.username || '';
    }
    if (!target) { root.innerHTML = '<p class="quote-kicker">Quoteboard</p><h1>Citazioni</h1><p class="quote-status">Utente mancante.</p>'; return; }
    const response = await fetch(`/api/quotes?username=${encodeURIComponent(target)}&v=${Date.now()}`, { headers:headers(), cache:'no-store' });
    const data = await response.json().catch(() => ({}));
    if (!response.ok) { root.innerHTML = `<p class="quote-kicker">Quoteboard</p><h1>Citazioni</h1><p class="quote-status">${esc(data.error || 'Quoteboard non disponibile.')}</p>`; return; }
    renderShell(data);
  };

  load().catch(error => { root.innerHTML = `<p class="quote-kicker">Quoteboard</p><h1>Citazioni</h1><p class="quote-status">${esc(error.message)}</p>`; });
})();
</script>
