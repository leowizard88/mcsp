---
layout: base.njk
title: Riviera Fallita
---
<style>
  body:has(.riviera-fallita-page),
  .site-main:has(.riviera-fallita-page) {
    background: #000 !important;
  }

  .riviera-fallita-page {
    min-height: 100vh;
    margin: 0;
    padding: clamp(18px, 4vw, 42px) 16px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    background: url('/assets/img/lol.jpg') center center / cover no-repeat;
    overflow: hidden;
  }

  .riviera-title {
    margin: 0;
    text-align: center;
    font-family: Impact, Haettenschweiler, 'Arial Black', sans-serif;
    font-size: clamp(38px, 9vw, 132px);
    line-height: .9;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: clamp(1px, .18vw, 3px) rgba(255,255,255,.92);
    background:
      repeating-radial-gradient(ellipse at 50% 120%, #ffffff 0 6px, #00d8ff 7px 15px, #006bff 16px 25px, #001a88 26px 35px, #ffffff 36px 42px),
      repeating-linear-gradient(180deg, #ffffff 0 6px, #00e5ff 7px 14px, #0057ff 15px 23px, #ffffff 24px 30px);
    background-size: 100% 32px, 100% 42px;
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(4px 4px 0 #000) drop-shadow(0 0 10px rgba(0,220,255,.75));
    animation: rivieraTextWaves 1.4s linear infinite;
  }

  @keyframes rivieraTextWaves {
    from { background-position: 0 0, 0 0; }
    to { background-position: 0 32px, 0 42px; }
  }

  @media(max-width:760px) {
    .riviera-fallita-page {
      padding-top: 26px;
    }

    .riviera-title {
      font-size: clamp(38px, 14vw, 82px);
      -webkit-text-stroke: 1px rgba(255,255,255,.92);
    }
  }
</style>

<section class="riviera-fallita-page" aria-label="Riviera Fallita">
  <h1 class="riviera-title">RIVIERA FALLITA</h1>
</section>
