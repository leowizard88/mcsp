<style>
  body:has(.riviera-fallita-page), .site-main:has(.riviera-fallita-page){background:#000!important}
  .riviera-fallita-page{min-height:100vh;margin:0;padding:clamp(18px,4vw,42px) 16px;display:flex;flex-direction:column;align-items:center;gap:clamp(24px,5vw,54px);background:url('/assets/img/lol.jpg') center/cover no-repeat;overflow:hidden}
  .riviera-title{margin:0;text-align:center;font-family:Impact,Haettenschweiler,'Arial Black',sans-serif;font-size:clamp(38px,9vw,132px);line-height:.9;letter-spacing:.02em;text-transform:uppercase;color:transparent;-webkit-text-fill-color:transparent;-webkit-text-stroke:clamp(1px,.18vw,3px) rgba(255,255,255,.92);background:repeating-radial-gradient(ellipse at 50% 120%,#fff 0 6px,#00d8ff 7px 15px,#006bff 16px 25px,#001a88 26px 35px,#fff 36px 42px),repeating-linear-gradient(180deg,#fff 0 6px,#00e5ff 7px 14px,#0057ff 15px 23px,#fff 24px 30px);background-size:100% 32px,100% 42px;-webkit-background-clip:text;background-clip:text;filter:drop-shadow(4px 4px 0 #000) drop-shadow(0 0 10px rgba(0,220,255,.75));animation:rivieraTextWaves 1.4s linear infinite}
  .chrollo-box{width:min(620px,calc(100vw - var(--side,44px) - 42px));border:2px solid rgba(255,255,255,.85);background:rgba(0,0,0,.68);box-shadow:6px 6px 0 rgba(0,0,0,.72),0 0 22px rgba(0,210,255,.26);color:#eaffff;font-family:'Courier New',monospace;backdrop-filter:blur(2px) saturate(1.2)}
  .chrollo-head{padding:8px 10px;border-bottom:2px solid rgba(255,255,255,.85);background:linear-gradient(90deg,rgba(20,20,26,.96),rgba(0,80,120,.82));font:700 13px/1.1 'Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;text-shadow:2px 2px 0 #000}
  .chrollo-log{height:min(300px,34vh);overflow:auto;padding:12px;display:grid;gap:10px;font-size:13px;line-height:1.35}
  .chrollo-message{max-width:92%;padding:8px 9px;border:1px solid rgba(255,255,255,.38);background:rgba(0,0,0,.52);white-space:pre-wrap}
  .chrollo-message.user{margin-left:auto;color:#00131c;background:rgba(180,245,255,.88)}
  .chrollo-message.bot{margin-right:auto;color:#eaffff}
  .chrollo-form{display:grid;grid-template-columns:1fr auto;gap:8px;padding:10px;border-top:2px solid rgba(255,255,255,.85);background:rgba(0,0,0,.48)}
  .chrollo-form input{min-width:0;border:1px solid rgba(255,255,255,.72);background:rgba(0,0,0,.72);color:#eaffff;font:14px/1.2 'Courier New',monospace;padding:9px 10px;outline:none}
  .chrollo-form button{border:1px solid #fff;background:#eaffff;color:#00131c;font:700 12px/1 'Courier New',monospace;letter-spacing:.08em;text-transform:uppercase;padding:0 12px;cursor:pointer}
  .greed-entry{margin:clamp(22px,6vh,70px) auto 8px;text-align:center;text-decoration:none;font-family:Impact,Haettenschweiler,'Arial Black',serif;font-size:clamp(42px,8.4vw,120px);line-height:.82;text-transform:uppercase;letter-spacing:.045em;color:#7cff2f;-webkit-text-stroke:clamp(2px,.25vw,5px) #061500;text-shadow:0 3px 0 #eaff6a,0 7px 0 #188000,0 12px 0 #061500,8px 8px 0 #4a006e,-8px -4px 0 #d8ff00,0 0 20px rgba(124,255,47,.95),0 0 46px rgba(144,0,255,.55);filter:drop-shadow(0 0 10px #9cff00) drop-shadow(0 0 24px rgba(106,0,255,.72));transform:skew(-8deg) rotate(-1deg);display:block;max-width:min(1000px,94vw);padding:.08em .16em;background:linear-gradient(180deg,rgba(255,255,255,.18),rgba(0,0,0,0));border-radius:18px}
  .greed-entry:hover{color:#caff74;transform:skew(-8deg) rotate(-1deg) scale(1.045);text-shadow:0 3px 0 #fff985,0 8px 0 #0c8f00,0 13px 0 #020900,10px 10px 0 #65008f,-10px -5px 0 #f3ff00,0 0 26px rgba(159,255,63,1),0 0 58px rgba(170,0,255,.75)}
  @keyframes rivieraTextWaves{from{background-position:0 0,0 0}to{background-position:0 32px,0 42px}}
  @media(max-width:760px){.riviera-fallita-page{padding-top:26px}.riviera-title{font-size:clamp(38px,14vw,82px);-webkit-text-stroke:1px rgba(255,255,255,.92)}.chrollo-box{width:calc(100vw - var(--side,38px) - 28px)}.chrollo-form{grid-template-columns:1fr}.chrollo-form button{min-height:34px}.greed-entry{font-size:clamp(36px,13vw,72px);-webkit-text-stroke:2px #061500}}
</style>

<section class="riviera-fallita-page" aria-label="Riviera Fallita">
  <h1 class="riviera-title">RIVIERA FALLITA</h1>
  <section class="chrollo-box" aria-label="Chatta con Chrollo">
    <div class="chrollo-head">CHATTA CON CHROLLO!</div>
    <div class="chrollo-log" data-chrollo-log><div class="chrollo-message bot">Parla con precisione. Le domande vaghe non hanno molto valore.</div></div>
    <form class="chrollo-form" data-chrollo-form><input name="message" autocomplete="off" placeholder="Scrivi a Chrollo..."><button type="submit">Invia</button></form>
  </section>
  <a class="greed-entry" href="/greed-island/">ENTRA IN GREED ISLAND</a>
</section>
