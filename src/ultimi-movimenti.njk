---
layout: base.njk
title: Ultimi movimenti | MANCUSPIE
permalink: /ultimi-movimenti/
---
<style>
  .ultimi-page {
    min-height: 100vh;
    min-height: 100svh;
    background-image:
      linear-gradient(rgba(0,0,0,.04), rgba(0,0,0,.10)),
      url('/assets/img/638cde03da9ac7f50e8586e7e2491440.jpg');
    background-size: cover, cover;
    background-position: center center, center center;
    background-repeat: no-repeat, no-repeat;
    display: block;
    padding: clamp(34px, 5vw, 70px) clamp(20px, 4vw, 56px);
  }

  .ultimi-page::before,
  .ultimi-page::after {
    display: none !important;
  }

  .archive-star {
    position: fixed;
    top: clamp(16px, 2vw, 28px);
    right: clamp(16px, 2vw, 30px);
    z-index: 20;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    color: #fff;
    background: #b40000;
    clip-path: polygon(50% 0%,61% 32%,95% 18%,72% 48%,100% 68%,63% 66%,50% 100%,37% 66%,0% 68%,28% 48%,5% 18%,39% 32%);
    font: 300 10px/1 var(--font-sans);
    letter-spacing: .08em;
    text-transform: uppercase;
    transform: rotate(10deg);
  }

  .archive-star:hover {
    transform: rotate(-7deg) scale(1.08);
  }

  .ultimi-header {
    position: relative;
    z-index: 4;
    width: 100%;
    text-align: center;
    padding-top: clamp(8px, 2vw, 28px);
  }

  .ultimi-title {
    display: block;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(54px, 8vw, 132px);
    line-height: .88;
    font-weight: 300;
    letter-spacing: .01em;
    white-space: nowrap;
    color: #fff;
    background: transparent;
    padding: 0;
    text-shadow:
      0 2px 8px rgba(0,0,0,.75),
      0 0 2px rgba(0,0,0,.95);
  }

  .ultimi-subtitle {
    width: fit-content;
    max-width: min(92vw, 980px);
    margin: clamp(18px, 2.6vw, 32px) auto 0;
    font-family: var(--font-sans);
    font-size: clamp(14px, 1.45vw, 24px);
    line-height: 1.25;
    font-weight: 300;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(0,0,0,.84);
    padding: .45em .8em .5em;
  }

  .movimenti-board {
    position: relative;
    z-index: 4;
    width: min(980px, 92vw);
    margin: clamp(54px, 9vh, 112px) auto 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(10px, 1.4vw, 18px);
    align-items: stretch;
  }

  .movimento-card {
    min-height: clamp(150px, 18vw, 230px);
    padding: clamp(14px, 1.6vw, 22px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(255,255,255,.88);
    color: #111;
    border: 1px solid rgba(0,0,0,.18);
    box-shadow: 0 14px 34px rgba(0,0,0,.22);
    transform: rotate(var(--tilt));
  }

  .movimento-card:nth-child(1){--tilt:-1.4deg}
  .movimento-card:nth-child(2){--tilt:.8deg}
  .movimento-card:nth-child(3){--tilt:-.5deg}
  .movimento-card:nth-child(4){--tilt:1.2deg}
  .movimento-card:nth-child(5){--tilt:-.9deg}

  .movimento-card:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .movimento-card time {
    font: 300 10px/1.2 var(--font-sans);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #7b0000;
  }

  .movimento-card strong {
    display: block;
    margin-top: 16px;
    font-family: var(--font-serif);
    font-size: clamp(23px, 2.4vw, 38px);
    line-height: .92;
    font-weight: 300;
  }

  .movimento-card span {
    margin-top: 22px;
    font: 300 10px/1.2 var(--font-sans);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  @media(max-width:980px){
    .movimenti-board{grid-template-columns:repeat(2,minmax(0,1fr))}
  }

  @media(max-width:760px){
    .ultimi-page{background-position:center center, center center}
    .ultimi-title{font-size:clamp(37px,11vw,64px);letter-spacing:-.02em;white-space:normal}
    .ultimi-subtitle{font-size:12px;letter-spacing:.06em}
    .movimenti-board{grid-template-columns:1fr;width:min(420px,92vw)}
    .archive-star{width:34px;height:34px;right:12px;top:12px}
  }
</style>

<section class="ultimi-page panel">
  <a class="archive-star" href="/archivio/" aria-label="Vai all'archivio">A</a>

  <header class="ultimi-header">
    <h1 class="ultimi-title">ULTIMI MOVIMENTI</h1>
    <p class="ultimi-subtitle">gli ultimi prodotti freschi 1''000%</p>
  </header>

  <div class="movimenti-board" aria-label="Ultimi cinque articoli pubblicati">
    {% for post in collections.testi | reverse %}
      {% if loop.index0 < 5 %}
      <a class="movimento-card" href="{{ post.url }}">
        <div>
          <time datetime="{{ post.data.date | dateISO }}">{{ post.data.date | dateISO }}</time>
          <strong>{{ post.data.title }}</strong>
        </div>
        <span>leggi</span>
      </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
