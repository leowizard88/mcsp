---
layout: base.njk
title: Ultimi movimenti | MANCUSPIE
permalink: /ultimi-movimenti/
---
<style>
  html:has(.ultimi-page), body:has(.ultimi-page), .site-main:has(.ultimi-page) { background:#050000!important; }
  .ultimi-page{min-height:100vh;min-height:100svh;background-image:linear-gradient(rgba(0,0,0,.04),rgba(0,0,0,.10)),url('/assets/img/638cde03da9ac7f50e8586e7e2491440.jpg');background-size:cover,cover;background-position:center center,center center;background-repeat:no-repeat,no-repeat;display:block;padding:clamp(34px,5vw,70px) clamp(20px,4vw,56px);overflow:hidden;margin:0}.ultimi-bg-figure{position:fixed;z-index:2;right:0;bottom:0;width:clamp(320px,42vw,680px);height:clamp(280px,38vw,610px);pointer-events:none;background:url('/assets/img/a8cc0d83120c1f4148e94b1b25b8c69c-removebg-preview.png') right bottom/contain no-repeat;opacity:.28}.ultimi-page::before,.ultimi-page::after{display:none!important}.archive-star{position:fixed;top:34px!important;right:162px!important;z-index:10060!important;width:42px;height:42px;display:block;color:transparent;font-size:0;background:#b40000;clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 92%,50% 70%,21% 92%,32% 57%,2% 35%,39% 35%);transform:rotate(10deg)}.archive-star:hover{transform:rotate(-7deg) scale(1.08)}.ultimi-header{position:relative;z-index:4;width:100%;text-align:center;padding-top:clamp(8px,2vw,28px)}.ultimi-title{display:block;margin:0;font-family:var(--font-serif);font-size:clamp(54px,8vw,132px);line-height:.88;font-weight:300;letter-spacing:.01em;white-space:nowrap;color:#fff;background:transparent;padding:0;text-shadow:0 0 3px rgba(255,255,255,1),0 0 10px rgba(255,255,255,.96),0 0 22px rgba(255,255,255,.90),0 0 46px rgba(255,255,255,.82),0 0 84px rgba(255,255,255,.64),0 0 118px rgba(255,255,255,.48),0 4px 18px rgba(0,0,0,.92);filter:brightness(1.18)}.ultimi-subtitle{width:fit-content;max-width:min(92vw,980px);margin:clamp(18px,2.6vw,32px) auto 0;font-family:var(--font-sans);font-size:clamp(14px,1.45vw,24px);line-height:1.25;font-weight:300;letter-spacing:.08em;text-transform:uppercase;color:#fff;background:transparent;padding:0;text-shadow:0 2px 8px rgba(0,0,0,.80),0 0 2px rgba(0,0,0,.95)}.movimenti-board{position:relative;z-index:4;width:min(1120px,100%);margin:clamp(48px,8vh,96px) auto 0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:clamp(2px,.8vw,12px);align-items:end;justify-items:center}.movimento-card{position:relative;width:100%;min-height:clamp(210px,24vw,350px);padding:clamp(46px,5vw,82px) clamp(16px,1.6vw,26px) clamp(34px,3vw,56px);display:flex;flex-direction:column;justify-content:center;color:#0d0b09;text-align:center;background:transparent;border:0;box-shadow:none;transform:rotate(var(--tilt))}.movimento-card::before{content:"";position:absolute;inset:0;z-index:-1;background:url('/assets/img/0d85d27e26d4e9bcebe0a0c9bd30d5f5-removebg-preview.png') center/contain no-repeat;filter:drop-shadow(0 12px 18px rgba(0,0,0,.25))}.movimento-card:nth-child(1){--tilt:-1.4deg}.movimento-card:nth-child(2){--tilt:.8deg}.movimento-card:nth-child(3){--tilt:-.5deg}.movimento-card:nth-child(4){--tilt:1.2deg}.movimento-card:nth-child(5){--tilt:-.9deg}.movimento-card:hover{animation:cardVibra .12s steps(2,end) infinite}@keyframes cardVibra{0%{transform:rotate(var(--tilt)) translate(0,0)}25%{transform:rotate(calc(var(--tilt) * -1)) translate(1px,-1px)}50%{transform:rotate(var(--tilt)) translate(-1px,1px)}75%{transform:rotate(calc(var(--tilt) * -1)) translate(1px,1px)}100%{transform:rotate(var(--tilt)) translate(-1px,0)}}.movimento-card time{display:inline;font:300 9px/1.2 var(--font-sans);letter-spacing:.10em;text-transform:uppercase;color:#7b0000;background:rgba(255,255,255,.82);padding:.14em .34em .18em;box-decoration-break:clone;-webkit-box-decoration-break:clone}.movimento-card strong{display:inline;margin:12px auto 0;max-width:13ch;font-family:var(--font-serif);font-size:clamp(20px,2vw,32px);line-height:1.02;font-weight:300;background:rgba(255,255,255,.86);padding:.04em .18em .12em;box-decoration-break:clone;-webkit-box-decoration-break:clone}.movimento-card .movimento-author{display:inline-block;width:fit-content;margin:13px auto 0;font:300 10px/1.2 var(--font-sans);letter-spacing:.10em;text-transform:uppercase;color:#7b0000;background:rgba(255,255,255,.82);padding:.16em .38em .20em}.movimento-card span:not(.movimento-author){display:inline-block;width:fit-content;margin:16px auto 0;font:300 9px/1.2 var(--font-sans);letter-spacing:.12em;text-transform:uppercase;background:rgba(255,255,255,.76);padding:.14em .34em .18em}@media(max-width:980px){.movimenti-board{grid-template-columns:repeat(2,minmax(0,1fr));width:min(720px,100%)}}@media(max-width:760px){.ultimi-page{background-position:center center,center center;padding-left:22px;padding-right:22px}.ultimi-bg-figure{width:320px;height:280px;opacity:.20;right:0;bottom:0}.ultimi-title{font-size:clamp(37px,11vw,64px);letter-spacing:-.02em;white-space:normal}.ultimi-subtitle{font-size:12px;letter-spacing:.06em}.movimenti-board{grid-template-columns:1fr;width:100%;max-width:390px;justify-items:center}.movimento-card{min-height:270px;width:100%;max-width:390px}.archive-star{width:34px;height:34px;right:92px!important;top:22px!important}}
</style>

<section class="ultimi-page panel">
  <span class="ultimi-bg-figure" aria-hidden="true"></span>
  <a class="archive-star" href="/archivio/" aria-label="Vai all'archivio"></a>
  <header class="ultimi-header"><h1 class="ultimi-title">ULTIMI MOVIMENTI</h1><p class="ultimi-subtitle">gli ultimi prodotti freschi 1''000%</p></header>
  <div class="movimenti-board" aria-label="Ultimi cinque articoli pubblicati">
    {% for post in collections.testi | reverse %}
      {% if loop.index0 < 5 %}
      <a class="movimento-card" href="{{ post.url }}"><div><time datetime="{{ post.data.date | dateISO }}">{{ post.data.date | dateISO }}</time><strong>{{ post.data.title }}</strong>{% if post.data.author %}<span class="movimento-author">di {{ post.data.author }}</span>{% endif %}</div><span>leggi</span></a>
      {% endif %}
    {% endfor %}
  </div>
</section>
