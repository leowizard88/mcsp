<style>
  html,
  body,
  .site-main,
  body:has(.pcz-tesseramento),
  body:has(.pcz-tesseramento) .site-main,
  .site-main:has(.pcz-tesseramento) {
    background: #050505 !important;
    background-image: none !important;
  }

  body:has(.pcz-tesseramento)::before,
  body:has(.pcz-tesseramento)::after,
  .site-main:has(.pcz-tesseramento)::before,
  .site-main:has(.pcz-tesseramento)::after,
  .pcz-tesseramento::after {
    display: none !important;
    content: none !important;
    background: none !important;
  }

  .pcz-tesseramento,
  .pcz-tesseramento * {
    box-sizing: border-box;
  }

  .pcz-tesseramento {
    min-height: 100svh !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: clamp(24px, 4vw, 58px) clamp(12px, 3vw, 52px) !important;
    position: relative !important;
    display: grid !important;
    place-items: center !important;
    overflow-x: hidden !important;
    background: #050505 url('/assets/img/416d96d6-6d37-4fd4-8a09-1dacc26d68fd.jpeg') center center / cover no-repeat !important;
  }

  .pcz-tesseramento::before {
    content: '' !important;
    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    background: linear-gradient(90deg, rgba(0,0,0,.34), rgba(0,0,0,.08), rgba(0,0,0,.38)) !important;
    pointer-events: none !important;
    z-index: 1 !important;
  }

  .pcz-form-card {
    position: relative;
    z-index: 2;
    width: min(620px, 100%);
    max-width: 100%;
    padding: clamp(22px, 4vw, 42px);
    background: rgba(250,248,240,.92);
    border: 2px solid rgba(255,211,26,.72);
    box-shadow: 0 18px 70px rgba(0,0,0,.38);
    color: #151515;
    font-family: var(--font-sans);
    overflow: hidden;
  }

  .pcz-form-card h1 {
    margin: 0 0 8px;
    max-width: 100%;
    color: #050505;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(32px, 5.6vw, 56px);
    line-height: .96;
    text-transform: uppercase;
    letter-spacing: .01em;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .pcz-form-card p {
    margin: 0 0 24px;
    color: #263252;
    font-size: 14px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .pcz-form { display: grid; gap: 14px; }
  .pcz-field { display: grid; gap: 6px; min-width: 0; }

  .pcz-field label,
  .pcz-consenso legend {
    font-size: 12px;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: #061a46;
  }

  .pcz-field input,
  .pcz-field textarea {
    width: 100%;
    max-width: 100%;
    border: 1px solid rgba(6,26,70,.38);
    background: rgba(255,255,255,.86);
    color: #050505;
    padding: 12px 12px;
    font: 16px/1.35 var(--font-sans);
    outline: none;
  }

  .pcz-field textarea { min-height: 120px; resize: vertical; }

  .pcz-field input:focus,
  .pcz-field textarea:focus {
    border-color: #083a92;
    box-shadow: 0 0 0 3px rgba(8,58,146,.15);
  }

  .pcz-consenso {
    min-width: 0;
    margin: 4px 0 0;
    padding: 12px;
    border: 1px solid rgba(6,26,70,.32);
    background: rgba(255,255,255,.48);
  }

  .pcz-choice-row { display: flex; flex-wrap: wrap; gap: 18px 22px; margin-top: 10px; }

  .pcz-choice-row label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .pcz-submit {
    margin-top: 12px;
    min-height: 58px;
    width: 100%;
    border: 2px solid rgba(6,26,70,.35);
    background: rgba(5,5,5,.22);
    color: rgba(5,5,5,.45);
    font: 700 14px/1 var(--font-sans);
    letter-spacing: .22em;
    text-transform: uppercase;
    cursor: not-allowed;
    transition: filter .2s ease, box-shadow .2s ease, background .2s ease, color .2s ease, border-color .2s ease;
  }

  .pcz-submit.is-ready {
    cursor: pointer;
    border-color: #ffd31a;
    background: linear-gradient(180deg, #19b73d, #083a92);
    color: #ffd31a;
    box-shadow: 0 0 18px rgba(255,211,26,.75), 0 0 34px rgba(25,183,61,.42);
    filter: saturate(1.22);
  }

  .pcz-submit.is-ready:hover { box-shadow: 0 0 24px rgba(255,211,26,.95), 0 0 50px rgba(25,183,61,.55); }
  .pcz-submit.is-loading { cursor: wait; opacity: .72; }

  .pcz-status {
    min-height: 18px;
    margin-top: 8px !important;
    color: #061a46 !important;
    text-transform: none !important;
    letter-spacing: .02em !important;
    font-size: 13px !important;
  }

  .pcz-status.is-error { color: #8b0000 !important; }
  .pcz-status.is-ok { color: #0b6b24 !important; }

  @media(max-width:760px) {
    .pcz-tesseramento { padding: 14px 8px !important; place-items: start center !important; }
    .pcz-form-card { width: 100%; max-width: 100%; padding: 14px; }
    .pcz-form-card h1 { font-size: clamp(28px, 9vw, 36px); line-height: 1; letter-spacing: 0; }
    .pcz-form-card p { font-size: 12px; letter-spacing: .06em; margin-bottom: 18px; }
    .pcz-choice-row { gap: 14px; }
  }
</style>

<section class="single-page pcz-tesseramento">
  <article class="pcz-form-card">
    <h1>Tesseramento</h1>
    <p>Partito Comunista Zingaro</p>

    <form class="pcz-form" data-pcz-form>
      <div class="pcz-field">
        <label for="pcz-nome">Nome</label>
        <input id="pcz-nome" name="nome" type="text" autocomplete="given-name" required>
      </div>

      <div class="pcz-field">
        <label for="pcz-cognome">Cognome</label>
        <input id="pcz-cognome" name="cognome" type="text" autocomplete="family-name" required>
      </div>

      <div class="pcz-field">
        <label for="pcz-email">Email</label>
        <input id="pcz-email" name="email" type="email" autocomplete="email" required>
      </div>

      <div class="pcz-field">
        <label for="pcz-note">Note personali</label>
        <textarea id="pcz-note" name="note" required></textarea>
      </div>

      <fieldset class="pcz-consenso">
        <legend>Acconsento a diventare compagno del PCZ</legend>
        <div class="pcz-choice-row">
          <label><input type="radio" name="consenso" value="si" required> Sì</label>
          <label><input type="radio" name="consenso" value="no" required> No</label>
        </div>
      </fieldset>

      <button class="pcz-submit" type="submit" disabled data-pcz-submit>Invia</button>
      <p class="pcz-status" data-pcz-status></p>
    </form>
  </article>
</section>

<script>
(() => {
  const form = document.querySelector('[data-pcz-form]');
  if (!form) return;

  const submit = form.querySelector('[data-pcz-submit]');
  const status = form.querySelector('[data-pcz-status]');
  const fields = [...form.querySelectorAll('input[type="text"], input[type="email"], textarea')];

  const setStatus = (message, type) => {
    status.textContent = message;
    status.classList.toggle('is-error', type === 'error');
    status.classList.toggle('is-ok', type === 'ok');
  };

  const makeCode = () => Array.from({ length: 3 }, () => String(Math.floor(Math.random() * 1000)).padStart(3, '0')).join('-');
  const today = () => new Intl.DateTimeFormat('it-IT', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(new Date());

  const loadImage = src => new Promise((resolve, reject) => {
    const img = new Image();
    img.onload = () => resolve(img);
    img.onerror = reject;
    img.src = src;
  });

  const wrapLines = (text, maxChars, maxLines) => {
    const words = String(text || '').trim().replace(/\s+/g, ' ').split(' ');
    const lines = [];
    let line = '';
    for (const word of words) {
      const next = line ? `${line} ${word}` : word;
      if (next.length > maxChars && line) {
        lines.push(line);
        line = word;
        if (lines.length >= maxLines) break;
      } else {
        line = next;
      }
    }
    if (line && lines.length < maxLines) lines.push(line);
    return lines;
  };

  const makeCardPng = async ({ nome, cognome, note, code, date }) => {
    const img = await loadImage('/assets/img/tessera.png');
    const canvas = document.createElement('canvas');
    canvas.width = img.naturalWidth || 1597;
    canvas.height = img.naturalHeight || 1875;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

    const sx = canvas.width / 1597;
    const sy = canvas.height / 1875;
    const rect = (x, y, w, h) => ctx.fillRect(x * sx, y * sy, w * sx, h * sy);
    const text = (value, x, y, size, font) => {
      ctx.font = `${size * sx}px ${font}`;
      ctx.fillStyle = '#000';
      ctx.fillText(value, x * sx, y * sy);
    };

    ctx.fillStyle = '#fff';
    rect(338, 122, 520, 25);
    rect(204, 230, 246, 25);
    rect(790, 572, 300, 68);
    rect(18, 1265, 884, 388);

    text(`${nome} ${cognome}`.slice(0, 34), 430, 178, 45, 'Arial, Helvetica, sans-serif');
    text(date, 230, 292, 45, 'Arial, Helvetica, sans-serif');
    text(code, 815, 626, 48, 'Arial, Helvetica, sans-serif');

    const lines = wrapLines(note, 39, 7);
    lines.forEach((line, index) => text(line, 26, 1334 + index * 43, 39, 'Georgia, Times New Roman, serif'));

    return canvas.toDataURL('image/png');
  };

  const isReady = () => {
    const filled = fields.every(field => field.value.trim().length > 0);
    const yes = form.querySelector('input[name="consenso"][value="si"]')?.checked;
    const email = form.querySelector('input[type="email"]');
    return filled && yes && email.validity.valid;
  };

  const sync = () => {
    const ready = isReady();
    submit.disabled = !ready;
    submit.classList.toggle('is-ready', ready);
  };

  form.addEventListener('input', sync);
  form.addEventListener('change', sync);

  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (!isReady() || submit.classList.contains('is-loading')) return;

    const data = new FormData(form);
    const code = makeCode();
    const date = today();
    const payload = {
      nome: data.get('nome'),
      cognome: data.get('cognome'),
      email: data.get('email'),
      note: data.get('note'),
      consenso: data.get('consenso'),
      code,
      date
    };

    submit.disabled = true;
    submit.classList.add('is-loading');
    setStatus('Generazione tessera PNG...', '');

    try {
      payload.cardPng = await makeCardPng(payload);
      setStatus('Invio domanda...', '');

      const response = await fetch('/api/tessera', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Invio non riuscito');

      window.localStorage.setItem('pczTesseramentoProvvisorio', JSON.stringify(payload));
      setStatus('Domanda inviata. Controlla la tua email: la tessera PNG è allegata.', 'ok');
      form.reset();
    } catch (error) {
      setStatus(error.message || 'Errore durante invio domanda.', 'error');
    } finally {
      submit.classList.remove('is-loading');
      sync();
    }
  });

  sync();
})();
</script>
