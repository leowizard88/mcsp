---
layout: base.njk
title: Zingaristan
permalink: /zingaristan/
---
<style>
  html,
  body,
  .site-main,
  body:has(.zingaristan-home),
  body:has(.zingaristan-home) .site-main,
  .site-main:has(.zingaristan-home) {
    background: #050505 !important;
    background-image: none !important;
  }

  body:has(.zingaristan-home)::before,
  body:has(.zingaristan-home)::after,
  .site-main:has(.zingaristan-home)::before,
  .site-main:has(.zingaristan-home)::after,
  .zingaristan-home::after {
    display: none !important;
    content: none !important;
    background: none !important;
  }

  .zingaristan-home {
    min-height: 100svh !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: clamp(28px, 5vw, 76px) clamp(18px, 5vw, 70px) !important;
    position: relative !important;
    display: grid !important;
    place-items: center !important;
    overflow-x: hidden !important;
    overflow-y: hidden !important;
    background-color: #050505 !important;
    background-image: url('/assets/img/416d96d6-6d37-4fd4-8a09-1dacc26d68fd.jpeg') !important;
    background-size: cover !important;
    background-position: center center !important;
    background-repeat: no-repeat !important;
  }

  .zingaristan-home::before {
    content: '' !important;
    position: absolute !important;
    inset: 0 !important;
    display: block !important;
    background: linear-gradient(90deg, rgba(0,0,0,.16), rgba(0,0,0,0), rgba(0,0,0,.18)) !important;
    pointer-events: none !important;
    z-index: 1 !important;
  }

  .zingaristan-portal {
    position: relative;
    z-index: 2;
    width: min(1040px, 92vw);
    min-height: min(680px, 80svh);
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: center;
    text-align: center;
  }

  .zingaristan-title-wrap {
    position: relative;
    display: grid;
    place-items: center;
    padding-top: clamp(20px, 7vw, 96px);
  }

  .zingaristan-title {
    width: min(980px, 90vw);
    height: clamp(160px, 29vw, 330px);
    overflow: visible;
    filter: drop-shadow(0 2px 0 rgba(0,0,0,.16));
  }

  .zingaristan-title text {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 86px;
    font-weight: 800;
    letter-spacing: .055em;
    text-transform: uppercase;
    paint-order: stroke fill;
    stroke: rgba(0,0,0,.22);
    stroke-width: 1.15px;
  }

  .zingaristan-title .z-black { fill: #050505; }
  .zingaristan-title .z-blue { fill: #083a92; }
  .zingaristan-title .z-green { fill: #19b73d; }
  .zingaristan-title .z-yellow { fill: #ffd31a; }

  .zingaristan-official {
    margin: clamp(-28px, -3vw, -10px) 0 0;
    color: #ffe066;
    font-family: var(--font-sans);
    font-size: clamp(15px, 2.2vw, 30px);
    letter-spacing: .28em;
    text-transform: uppercase;
    text-shadow: 0 1px 2px rgba(0,0,0,.36);
  }

  .zingaristan-actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(12px, 3vw, 38px);
    align-items: end;
    margin-top: clamp(34px, 7vw, 86px);
  }

  .zingaristan-button {
    min-height: 64px;
    display: grid;
    place-items: center;
    padding: 18px 14px;
    border: 2px solid rgba(255,211,26,.82);
    background: linear-gradient(180deg, rgba(5,5,5,.42), rgba(8,58,146,.30));
    color: #ffd31a !important;
    font-family: var(--font-sans);
    font-size: clamp(12px, 1.5vw, 17px);
    letter-spacing: .15em;
    text-transform: uppercase;
    text-decoration: none !important;
    box-shadow: 0 4px 10px rgba(0,0,0,.18), inset 0 0 0 1px rgba(25,183,61,.30);
  }

  .zingaristan-button.is-disabled {
    opacity: .78;
    cursor: default;
    pointer-events: none;
    filter: grayscale(.08);
  }

  .zingaristan-button:hover {
    background: linear-gradient(180deg, rgba(25,183,61,.72), rgba(8,58,146,.76));
    transform: translateY(-2px);
  }

  @media(max-width:760px) {
    .zingaristan-home {
      padding: 20px 8px !important;
      place-items: center !important;
      background-position: center center !important;
    }
    .zingaristan-home::before {
      background: linear-gradient(90deg, rgba(0,0,0,.08), rgba(0,0,0,0), rgba(0,0,0,.10)) !important;
    }
    .zingaristan-portal {
      width: 100%;
      max-width: calc(100vw - 16px);
      min-height: 78svh;
      overflow: visible;
    }
    .zingaristan-title-wrap { padding-top: 14px; overflow: visible; }
    .zingaristan-title {
      width: 100%;
      max-width: 100%;
      height: 250px;
      overflow: visible;
      transform: none;
    }
    .zingaristan-title text { font-size: 70px; letter-spacing: .012em; stroke-width: 1px; }
    .zingaristan-official { margin-top: -50px; font-size: 14px; letter-spacing: .16em; }
    .zingaristan-actions { grid-template-columns: 1fr; gap: 12px; margin-top: 44px; }
    .zingaristan-button { min-height: 52px; padding: 14px 12px; background: linear-gradient(180deg, rgba(5,5,5,.34), rgba(8,58,146,.24)); }
  }
</style>

<section class="single-page zingaristan-home">
  <div class="zingaristan-portal">
    <div class="zingaristan-title-wrap">
      <svg class="zingaristan-title" viewBox="0 0 1100 330" aria-label="Zingaristan" role="img">
        <defs>
          <path id="zingaristanCurve" d="M85 230 C250 65 850 65 1015 230" />
        </defs>
        <text>
          <textPath href="#zingaristanCurve" startOffset="50%" text-anchor="middle">
            <tspan class="z-black">Z</tspan><tspan class="z-blue">I</tspan><tspan class="z-green">N</tspan><tspan class="z-yellow">G</tspan><tspan class="z-black">A</tspan><tspan class="z-blue">R</tspan><tspan class="z-green">I</tspan><tspan class="z-yellow">S</tspan><tspan class="z-black">T</tspan><tspan class="z-blue">A</tspan><tspan class="z-green">N</tspan>
          </textPath>
        </text>
      </svg>
      <p class="zingaristan-official">homepage ufficiale</p>
    </div>

    <nav class="zingaristan-actions" aria-label="Sezioni Zingaristan">
      <span class="zingaristan-button is-disabled">Tesseramento</span>
      <a class="zingaristan-button" href="/zingaristan/wiki/">Wiki</a>
      <span class="zingaristan-button is-disabled">Il programma</span>
    </nav>
  </div>
</section>
